/* pages/ticket-detail/ticket-detail.wxss */

/* 基础样式 */
.container {
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #f5f7fa 0%, #e4e7eb 100%);
  }
  
  /* 状态栏 */
  .status-bar {
    padding: 40rpx 32rpx;
    background: linear-gradient(135deg, #007AFF, #00B2FF);
    border-radius: 0 0 40rpx 40rpx;
    box-shadow: 0 10rpx 30rpx rgba(0, 122, 255, 0.3);
  }
  
  .status-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .status-label {
    font-size: 44rpx;
    font-weight: 700;
    color: white;
    margin-bottom: 8rpx;
  }
  
  .status-time {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.9);
  }
  
  /* 内容区域 */
  .content {
    flex: 1;
    padding: 32rpx;
    padding-bottom: 160rpx;
  }
  
  /* 卡片通用样式 */
  .card {
    background: white;
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
    border: 1rpx solid rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
  }
  
  .card:active {
    transform: translateY(-4rpx);
    box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  }
  
  .card-title {
    display: flex;
    align-items: center;
    font-size: 32rpx;
    font-weight: 600;
    color: #1a1a1a;
    margin-bottom: 28rpx;
  }
  
  .card-title-icon {
    font-size: 36rpx;
    margin-right: 16rpx;
  }
  
  .card-content {
    font-size: 28rpx;
    color: #333;
    line-height: 1.6;
  }
  
  /* 标题卡片 */
  .title-card {
    background: linear-gradient(135deg, #ffffff, #f8f9ff);
    border-left: 8rpx solid #007AFF;
  }
  
  .title-card .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24rpx;
  }
  
  .type-tag {
    padding: 8rpx 20rpx;
    border-radius: 20rpx;
    font-size: 24rpx;
    font-weight: 500;
  }
  
  .time {
    font-size: 24rpx;
    color: #8E8E93;
  }
  
  .title {
    font-size: 40rpx;
    font-weight: 700;
    color: #1a1a1a;
    margin-bottom: 32rpx;
    line-height: 1.4;
  }
  
  .submitter {
    display: flex;
    align-items: center;
    padding-top: 24rpx;
    border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  }
  
  .avatar {
    width: 64rpx;
    height: 64rpx;
    border-radius: 50%;
    margin-right: 16rpx;
    border: 2rpx solid #007AFF;
  }
  
  .nickname {
    flex: 1;
    font-size: 28rpx;
    color: #333;
  }
  
  .contact-icon {
    font-size: 32rpx;
    margin-left: 16rpx;
    opacity: 0.7;
  }
  
  /* 描述文本 */
  .description {
    color: #333;
    line-height: 1.8;
    font-size: 30rpx;
    text-align: justify;
  }
  
  /* 图片区域 */
  .images {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
    margin-top: 8rpx;
  }
  
  .image-wrapper {
    position: relative;
    width: 220rpx;
    height: 220rpx;
    border-radius: 16rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  }
  
  .image-item {
    width: 100%;
    height: 100%;
  }
  
  .image-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: rgba(0, 0, 0, 0.7);
    padding: 16rpx;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  
  .preview-text {
    color: white;
    font-size: 24rpx;
    opacity: 0.9;
  }
  
  /* 位置信息 */
  .location-info {
    padding: 24rpx;
    background: linear-gradient(135deg, #f8f9fa, #e9ecef);
    border-radius: 16rpx;
  }
  
  .address {
    font-size: 30rpx;
    color: #333;
    line-height: 1.6;
    margin-bottom: 20rpx;
  }
  
  .coordinates {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 26rpx;
    color: #666;
  }
  
  .coordinate-actions {
    display: flex;
    gap: 16rpx;
  }
  
  .mini-btn {
    padding: 12rpx 24rpx !important;
    font-size: 24rpx !important;
    line-height: 1 !important;
    border-radius: 20rpx !important;
    margin: 0 !important;
  }
  
  .copy-btn {
    background: #34C759 !important;
    color: white !important;
  }
  
  .navigate-btn {
    background: #007AFF !important;
    color: white !important;
  }
  
  /* 处理进度时间线 */
  .process-timeline {
    position: relative;
    padding-left: 40rpx;
  }
  
  .process-timeline::before {
    content: '';
    position: absolute;
    left: 20rpx;
    top: 0;
    bottom: 0;
    width: 2rpx;
    background: #E0E0E0;
  }
  
  .process-step {
    position: relative;
    margin-bottom: 40rpx;
  }
  
  .process-step:last-child {
    margin-bottom: 0;
  }
  
  .step-dot {
    position: absolute;
    left: -40rpx;
    top: 0;
    width: 40rpx;
    height: 40rpx;
    border-radius: 50%;
    background: white;
    border: 4rpx solid #E0E0E0;
    box-sizing: border-box;
  }
  
  .process-step.active .step-dot {
    border-color: #007AFF;
    background: #007AFF;
  }
  
  .step-content {
    padding: 8rpx 0;
  }
  
  .step-title {
    display: block;
    font-size: 30rpx;
    font-weight: 500;
    color: #1a1a1a;
    margin-bottom: 8rpx;
  }
  
  .step-time {
    display: block;
    font-size: 24rpx;
    color: #8E8E93;
    margin-bottom: 4rpx;
  }
  
  .step-operator {
    display: block;
    font-size: 24rpx;
    color: #666;
  }
  
  /* 管理员回复 */
  .admin-reply {
    display: flex;
    gap: 24rpx;
    padding: 32rpx;
    background: linear-gradient(135deg, #f0f8ff, #e6f3ff);
    border-radius: 20rpx;
  }
  
  .admin-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    background: #007AFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 40rpx;
    color: white;
    flex-shrink: 0;
  }
  
  .reply-content {
    flex: 1;
  }
  
  .reply-text {
    display: block;
    font-size: 30rpx;
    color: #333;
    line-height: 1.6;
    margin-bottom: 12rpx;
  }
  
  .reply-time {
    font-size: 24rpx;
    color: #8E8E93;
  }
  
  /* 元信息卡片 */
  .meta-card {
    background: linear-gradient(135deg, #f8f9fa, #e9ecef);
  }
  
  .meta-info {
    display: flex;
    margin-bottom: 16rpx;
  }
  
  .meta-info:last-child {
    margin-bottom: 0;
  }
  
  .meta-label {
    width: 160rpx;
    font-size: 26rpx;
    color: #666;
  }
  
  .meta-value {
    flex: 1;
    font-size: 26rpx;
    color: #333;
    word-break: break-all;
  }
  
  /* 操作按钮栏 */
  .action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    padding: 24rpx 32rpx;
    display: flex;
    gap: 20rpx;
    box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
    z-index: 100;
  }
  
  .btn {
    flex: 1;
    height: 88rpx;
    border: none;
    border-radius: 22rpx;
    font-size: 32rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }
  
  .btn-hover {
    opacity: 0.9;
    transform: scale(0.98);
  }
  
  .cancel-btn {
    background: linear-gradient(135deg, #FF3B30, #FF6B6B);
    color: white;
    box-shadow: 0 6rpx 20rpx rgba(255, 59, 48, 0.3);
  }
  
  .share-btn {
    background: linear-gradient(135deg, #34C759, #5CDB95);
    color: white;
    box-shadow: 0 6rpx 20rpx rgba(52, 199, 89, 0.3);
  }
  
  /* 动画效果 */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20rpx);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .card {
    animation: fadeIn 0.4s ease-out;
    animation-fill-mode: both;
  }
  
  .card:nth-child(1) { animation-delay: 0.1s; }
  .card:nth-child(2) { animation-delay: 0.2s; }
  .card:nth-child(3) { animation-delay: 0.3s; }
  .card:nth-child(4) { animation-delay: 0.4s; }
  .card:nth-child(5) { animation-delay: 0.5s; }
  
  /* 响应式设计 */
  @media (max-width: 750rpx) {
    .content {
      padding: 24rpx;
      padding-bottom: 160rpx;
    }
    
    .card {
      padding: 24rpx;
    }
    
    .title {
      font-size: 36rpx;
    }
    
    .images {
      justify-content: center;
    }
    
    .image-wrapper {
      width: 180rpx;
      height: 180rpx;
    }
    
    .action-bar {
      padding: 20rpx 24rpx;
    }
  }