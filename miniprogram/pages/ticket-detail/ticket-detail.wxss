/* pages/ticket-detail/ticket-detail.wxss */

/* 基础容器样式 */
.container {
    padding: 20rpx;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    min-height: 100vh;
  }
  
  /* 卡片式区块设计 */
  .section {
    background: rgba(255, 255, 255, 0.95);
    margin-bottom: 24rpx;
    padding: 32rpx;
    border-radius: 20rpx;
    box-shadow: 
      0 4rpx 20rpx rgba(0, 0, 0, 0.08),
      inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(10rpx);
    border: 1rpx solid rgba(255, 255, 255, 0.2);
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }
  
  .section:active {
    transform: translateY(2rpx);
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  }
  
  /* 区块标题美化 */
  .section-title {
    font-size: 34rpx;
    font-weight: 700;
    margin-bottom: 28rpx;
    color: #1a1a1a;
    border-left: 8rpx solid;
    border-image: linear-gradient(to bottom, #007aff, #00c6ff) 1;
    padding-left: 24rpx;
    position: relative;
    letter-spacing: 0.5rpx;
  }
  
  .section-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4rpx;
    height: 80%;
    background: linear-gradient(to bottom, #007aff, #00c6ff);
    border-radius: 2rpx;
  }
  
  /* 信息项布局优化 */
  .info-item {
    display: flex;
    margin-bottom: 20rpx;
    align-items: flex-start;
    padding: 16rpx 0;
    border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
    transition: background-color 0.3s ease;
  }
  
  .info-item:last-child {
    border-bottom: none;
  }
  
  .info-item:active {
    background-color: rgba(0, 122, 255, 0.05);
    border-radius: 12rpx;
  }
  
  .label {
    color: #666;
    width: 180rpx;
    font-size: 28rpx;
    font-weight: 500;
    flex-shrink: 0;
  }
  
  .value {
    color: #1a1a1a;
    flex: 1;
    font-size: 28rpx;
    line-height: 1.5;
  }
  
  /* 状态标签美化 */
  .status {
    padding: 12rpx 24rpx;
    border-radius: 50rpx;
    font-size: 24rpx;
    font-weight: 600;
    text-align: center;
    min-width: 120rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .status::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    transition: left 0.5s;
  }
  
  .status:active::before {
    left: 100%;
  }
  
  .status.pending {
    background: linear-gradient(135deg, #ff7e5f, #feb47b);
    color: #fff;
  }
  
  .status.processing {
    background: linear-gradient(135deg, #4facfe, #00f2fe);
    color: #fff;
  }
  
  .status.completed {
    background: linear-gradient(135deg, #56ab2f, #a8e063);
    color: #fff;
  }
  
  .status.cancelled {
    background: linear-gradient(135deg, #9d9d9d, #c9c9c9);
    color: #fff;
  }
  
  /* 描述文本样式 */
  .description {
    color: #333;
    line-height: 1.8;
    font-size: 30rpx;
    text-align: justify;
    padding: 8rpx 0;
  }
  
  /* 图片区域美化 */
  .images {
    display: flex;
    flex-wrap: wrap;
    gap: 20rpx;
    margin-top: 16rpx;
  }
  
  .images image {
    width: 200rpx;
    height: 200rpx;
    border-radius: 16rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .images image:active {
    transform: scale(0.95);
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  }
  
  .images image::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border: 2rpx solid rgba(255, 255, 255, 0.3);
    border-radius: 16rpx;
    pointer-events: none;
  }
  
  /* 位置信息样式 */
  .location {
    color: #333;
    padding: 24rpx;
    background: linear-gradient(135deg, #f8f9fa, #e9ecef);
    border-radius: 12rpx;
    border-left: 6rpx solid #007aff;
    font-size: 28rpx;
    line-height: 1.6;
    box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.1);
  }
  
  .coordinates {
    font-size: 24rpx;
    color: #666;
    margin-top: 12rpx;
    opacity: 0.8;
  }
  
  /* 管理员回复样式 */
  .admin-reply {
    color: #1a1a1a;
    line-height: 1.7;
    padding: 28rpx;
    background: linear-gradient(135deg, #f0f8ff, #e6f3ff);
    border-radius: 16rpx;
    border-left: 6rpx solid #007aff;
    position: relative;
    box-shadow: 0 2rpx 12rpx rgba(0, 122, 255, 0.1);
  }
  
  .admin-reply::before {
    content: '"';
    font-size: 48rpx;
    color: #007aff;
    opacity: 0.3;
    position: absolute;
    top: 16rpx;
    left: 16rpx;
    font-family: serif;
  }
  
  /* 操作按钮区域 */
  .actions {
    padding: 32rpx;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 20rpx;
    margin-top: 8rpx;
    box-shadow: 
      0 4rpx 20rpx rgba(0, 0, 0, 0.08),
      inset 0 1rpx 0 rgba(255, 255, 255, 0.7);
  }
  
  .btn {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    border: none;
    border-radius: 50rpx;
    font-size: 32rpx;
    font-weight: 600;
    background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
    color: white;
    box-shadow: 
      0 6rpx 20rpx rgba(255, 107, 107, 0.3),
      inset 0 1rpx 0 rgba(255, 255, 255, 0.3);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .btn::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    transition: left 0.5s;
  }
  
  .btn:active {
    transform: translateY(2rpx);
    box-shadow: 0 2rpx 10rpx rgba(255, 107, 107, 0.4);
  }
  
  .btn:active::before {
    left: 100%;
  }
  
  /* 加载动画 */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30rpx);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .section {
    animation: fadeInUp 0.5s ease-out;
  }
  
  /* 响应式设计 */
  @media (max-width: 750rpx) {
    .container {
      padding: 16rpx;
    }
    
    .section {
      margin-bottom: 20rpx;
      padding: 28rpx;
    }
    
    .info-item {
      flex-direction: column;
      align-items: flex-start;
    }
    
    .label {
      width: 100%;
      margin-bottom: 8rpx;
    }
}