/* dynamic/dynamic.wxss */
/* 页面容器 */
.dynamic-container {
    min-height: 100vh;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  }
  
  /* 顶部选项卡美化 */
  .tab-bar {
    display: flex;
    background: white;
    padding: 0 30rpx;
    box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.08);
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .tab-item {
    flex: 1;
    text-align: center;
    padding: 32rpx 0;
    position: relative;
    transition: all 0.3s ease;
  }
  
  .tab-text {
    font-size: 30rpx;
    color: #666;
    font-weight: 500;
    transition: all 0.3s ease;
  }
  
  .tab-item.active .tab-text {
    color: #4CAF50;
    font-weight: 600;
  }
  
  .tab-indicator {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 4rpx;
    background: #4CAF50;
    border-radius: 2rpx;
    transition: all 0.3s ease;
  }
  
  .tab-item.active .tab-indicator {
    width: 60rpx;
  }
  
  /* 帖子列表 */
  .posts-list {
    height: calc(100vh - 120rpx);
    padding: 30rpx;
  }
  
  /* 帖子卡片美化 */
  .post-card {
    background: white;
    border-radius: 24rpx;
    margin-bottom: 30rpx;
    padding: 0;
    box-shadow: 0 6rpx 25rpx rgba(0, 0, 0, 0.08);
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    border: 1rpx solid #f0f0f0;
  }
  
  .post-card:active {
    transform: translateY(2rpx);
    box-shadow: 0 3rpx 15rpx rgba(0, 0, 0, 0.12);
  }
  
  /* 帖子头部 */
  .post-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 40rpx 40rpx 30rpx;
    border-bottom: 1rpx solid #f8f9fa;
  }
  
  .user-info {
    display: flex;
    align-items: center;
  }
  
  .user-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    border: 3rpx solid #f8f9fa;
    margin-right: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  }
  
  .user-meta {
    display: flex;
    flex-direction: column;
  }
  
  .user-name {
    font-size: 30rpx;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 8rpx;
  }
  
  .post-time {
    font-size: 24rpx;
    color: #95a5a6;
  }
  
  .post-type-badge {
    padding: 12rpx 24rpx;
    border-radius: 20rpx;
    font-size: 24rpx;
    font-weight: 500;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  }
  
  .post-type-badge.support {
    background: linear-gradient(135deg, #4CAF50, #45a049);
    color: white;
  }
  
  .post-type-badge.report {
    background: linear-gradient(135deg, #FF6B6B, #EE5A52);
    color: white;
  }
  
  /* 状态区域美化 */
  .status-section {
    padding: 0 40rpx;
    margin: 20rpx 0;
  }
  
  .status-badge {
    background: #f8f9fa;
    border-radius: 16rpx;
    padding: 30rpx;
    border-left: 6rpx solid #4CAF50;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  }
  
  .status-content {
    width: 100%;
  }
  
  .status-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15rpx;
  }
  
  .status-icon {
    font-size: 32rpx;
    margin-right: 12rpx;
  }
  
  .status-title {
    flex: 1;
    font-size: 28rpx;
    font-weight: 600;
  }
  
  .status-edit {
    font-size: 24rpx;
    color: #4CAF50;
    padding: 8rpx 20rpx;
    border: 1rpx solid #4CAF50;
    border-radius: 20rpx;
    background: white;
    transition: all 0.3s ease;
  }
  
  .status-edit:active {
    background: #4CAF50;
    color: white;
  }
  
  .status-desc {
    display: block;
    font-size: 24rpx;
    color: #7f8c8d;
    line-height: 1.5;
    margin-bottom: 20rpx;
  }
  
  /* 进度条样式 */
  .progress-bar {
    margin-top: 20rpx;
  }
  
  .progress-track {
    width: 100%;
    height: 8rpx;
    background: #ecf0f1;
    border-radius: 4rpx;
    overflow: hidden;
    margin-bottom: 15rpx;
  }
  
  .progress-fill {
    height: 100%;
    border-radius: 4rpx;
    transition: width 0.5s ease;
  }
  
  .progress-labels {
    display: flex;
    justify-content: space-between;
    position: relative;
  }
  
  .progress-label {
    font-size: 20rpx;
    color: #bdc3c7;
    text-align: center;
    flex: 1;
    position: relative;
    padding-top: 25rpx;
  }
  
  .progress-label::before {
    content: '';
    position: absolute;
    top: -20rpx;
    left: 50%;
    transform: translateX(-50%);
    width: 12rpx;
    height: 12rpx;
    background: #bdc3c7;
    border-radius: 50%;
    z-index: 2;
  }
  
  .progress-label.active {
    color: #2c3e50;
    font-weight: 500;
  }
  
  .progress-label.active::before {
    background: #4CAF50;
    box-shadow: 0 0 0 3rpx rgba(76, 175, 80, 0.2);
  }
  
  /* 帖子内容 */
  .post-content {
    padding: 0 40rpx 30rpx;
  }
  
  .post-title {
    display: block;
    font-size: 34rpx;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 20rpx;
    line-height: 1.4;
  }
  
  .post-desc {
    display: block;
    font-size: 28rpx;
    color: #5a6c7d;
    line-height: 1.6;
    margin-bottom: 30rpx;
  }
  
  /* 图片展示 */
  .post-images {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12rpx;
    margin-bottom: 30rpx;
  }
  
  .post-image {
    width: 100%;
    height: 200rpx;
    border-radius: 12rpx;
    background: #f5f5f5;
    transition: transform 0.3s ease;
  }
  
  .post-image:active {
    transform: scale(0.95);
  }
  
  .post-image.single-image {
    height: 400rpx;
    grid-column: span 3;
  }
  
  /* 位置信息 */
  .post-location {
    display: flex;
    align-items: center;
    padding: 20rpx;
    background: #f8f9fa;
    border-radius: 12rpx;
    margin-top: 20rpx;
  }
  
  .location-icon {
    margin-right: 15rpx;
    font-size: 24rpx;
  }
  
  .location-text {
    font-size: 24rpx;
    color: #666;
  }
  
  /* 帖子操作栏 */
  .post-actions {
    display: flex;
    border-top: 1rpx solid #f0f0f0;
    padding: 30rpx 40rpx;
    background: #fafbfc;
  }
  
  .action-item {
    display: flex;
    align-items: center;
    margin-right: 40rpx;
    padding: 15rpx 25rpx;
    border-radius: 25rpx;
    transition: all 0.3s ease;
    flex: 1;
    justify-content: center;
  }
  
  .action-item:active {
    background: #f0f2f5;
    transform: scale(0.95);
  }
  
  .action-item.liked {
    color: #FF6B6B;
  }
  
  .action-icon {
    font-size: 32rpx;
    margin-right: 10rpx;
  }
  
  .action-count, .action-text {
    font-size: 24rpx;
    color: #7f8c8d;
  }
  
  .action-item.liked .action-count {
    color: #FF6B6B;
    font-weight: 500;
  }
  
  /* 最新评论预览 */
  .comment-preview {
    background: #f8f9fa;
    padding: 25rpx 40rpx;
    border-top: 1rpx solid #f0f0f0;
  }
  
  .comment-header {
    margin-bottom: 15rpx;
  }
  
  .comment-label {
    font-size: 22rpx;
    color: #95a5a6;
    font-weight: 500;
  }
  
  .comment-content {
    display: flex;
    align-items: flex-start;
  }
  
  .comment-author {
    font-size: 24rpx;
    color: #4CAF50;
    font-weight: 500;
    margin-right: 10rpx;
    flex-shrink: 0;
  }
  
  .comment-text {
    font-size: 24rpx;
    color: #5a6c7d;
    line-height: 1.4;
    flex: 1;
  }
  
  /* 空状态 */
  .empty-state {
    text-align: center;
    padding: 120rpx 60rpx;
  }
  
  .empty-icon {
    font-size: 120rpx;
    margin-bottom: 40rpx;
    display: block;
    opacity: 0.5;
  }
  
  .empty-text {
    font-size: 36rpx;
    color: #2c3e50;
    display: block;
    margin-bottom: 20rpx;
    font-weight: 500;
  }
  
  .empty-subtext {
    font-size: 28rpx;
    color: #7f8c8d;
    display: block;
    margin-bottom: 60rpx;
  }
  
  .empty-btn {
    background: linear-gradient(135deg, #4CAF50, #45a049);
    color: white;
    border: none;
    border-radius: 50rpx;
    padding: 0 60rpx;
    height: 80rpx;
    font-size: 28rpx;
    font-weight: 500;
    box-shadow: 0 4rpx 15rpx rgba(76, 175, 80, 0.3);
  }
  
  .empty-btn:active {
    transform: translateY(2rpx);
    box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.4);
  }
  
  /* 加载状态 */
  .load-more, .no-more {
    text-align: center;
    padding: 40rpx;
    color: #95a5a6;
    font-size: 24rpx;
  }
  
  .loading-spinner {
    width: 40rpx;
    height: 40rpx;
    border: 4rpx solid #f3f3f3;
    border-top: 4rpx solid #4CAF50;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 20rpx;
  }
  
  .loading-text {
    font-size: 24rpx;
    color: #7f8c8d;
  }
  
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  
  /* 发布按钮 */
  .fab-button {
    position: fixed;
    right: 40rpx;
    bottom: 120rpx;
    width: 120rpx;
    height: 120rpx;
    background: linear-gradient(135deg, #4CAF50, #45a049);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8rpx 30rpx rgba(76, 175, 80, 0.4);
    z-index: 100;
    transition: all 0.3s ease;
  }
  
  .fab-button:active {
    transform: scale(0.95);
    box-shadow: 0 4rpx 20rpx rgba(76, 175, 80, 0.6);
  }
  
  .fab-icon {
    color: white;
    font-size: 50rpx;
    font-weight: 200;
  }