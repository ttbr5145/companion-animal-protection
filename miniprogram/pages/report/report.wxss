/* report/report.wxss */
.report-container {
    min-height: 100vh;
    background-color: #f5f5f5;
  }
  
  /* 顶部递交举报按钮区域 */
  .submit-section {
    padding: 20rpx;
    background: linear-gradient(135deg, #FF6B6B, #FF4444);
    border-radius: 0 0 20rpx 20rpx;
    box-shadow: 0 4rpx 12rpx rgba(255, 68, 68, 0.3);
  }
  
  .submit-btn {
    width: 100%;
    height: 88rpx;
    background: white;
    color: #FF4444;
    font-size: 32rpx;
    font-weight: 600;
    border-radius: 12rpx;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .btn-icon {
    font-size: 36rpx;
    font-weight: bold;
    margin-right: 12rpx;
  }
  
  /* 工单列表区域 */
  .ticket-list {
    padding: 20rpx;
  }
  
  .empty-state {
    text-align: center;
    padding: 100rpx 40rpx;
  }
  
  .empty-image {
    width: 200rpx;
    height: 200rpx;
    margin-bottom: 30rpx;
  }
  
  .empty-text {
    display: block;
    font-size: 32rpx;
    color: #999;
    margin-bottom: 16rpx;
  }
  
  .empty-tip {
    font-size: 26rpx;
    color: #ccc;
  }
  
  .list-title {
    font-size: 28rpx;
    color: #666;
    margin-bottom: 20rpx;
    display: block;
  }
  
  /* 工单项样式 */
  .ticket-item {
    background: white;
    border-radius: 12rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  }
  
  .ticket-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16rpx;
  }
  
  .ticket-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
    flex: 1;
  }
  
  .ticket-status {
    font-size: 24rpx;
    padding: 8rpx 16rpx;
    border-radius: 20rpx;
    font-weight: 500;
  }
  
  .ticket-status.pending {
    background: #FFF3CD;
    color: #856404;
  }
  
  .ticket-status.processing {
    background: #D1ECF1;
    color: #0C5460;
  }
  
  .ticket-status.resolved {
    background: #D4EDDA;
    color: #155724;
  }
  
  .ticket-status.rejected {
    background: #F8D7DA;
    color: #721C24;
  }
  
  .ticket-content {
    margin-bottom: 16rpx;
  }
  
  .content-text {
    font-size: 28rpx;
    color: #666;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .ticket-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .create-time {
    font-size: 24rpx;
    color: #999;
  }
  
  .contact-info {
    font-size: 24rpx;
    color: #666;
  }