/* pages/qualification/qualification.wxss */

/* 基础样式 */
.container {
    min-height: 100vh;
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    padding: 20rpx 0 40rpx;
    overflow-x: hidden;
    width: 100%;
    box-sizing: border-box;
  }
  
  /* 步骤指示器 */
  .steps-container {
    background: white;
    padding: 40rpx 30rpx 30rpx;
    margin-bottom: 24rpx;
    border-bottom: 1rpx solid #f1f5f9;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  }
  
  .steps {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
  }
  
  .step-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
    flex: 1;
  }
  
  .step-number {
    width: 60rpx;
    height: 60rpx;
    border-radius: 50%;
    background: #e5e7eb;
    color: #6b7280;
    font-size: 28rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12rpx;
    transition: all 0.3s ease;
    border: 3rpx solid transparent;
  }
  
  .step-item.active .step-number {
    background: #007AFF;
    color: white;
    border-color: rgba(0, 122, 255, 0.2);
    box-shadow: 0 0 0 8rpx rgba(0, 122, 255, 0.1);
  }
  
  .step-item.completed .step-number {
    background: #10b981;
    color: white;
  }
  
  .step-title {
    font-size: 24rpx;
    color: #9ca3af;
    font-weight: 500;
    transition: all 0.3s ease;
  }
  
  .step-item.active .step-title {
    color: #007AFF;
    font-weight: 600;
  }
  
  .step-item.completed .step-title {
    color: #10b981;
  }
  
  .step-line {
    position: absolute;
    top: 30rpx;
    left: 50%;
    width: calc(100% - 60rpx);
    height: 4rpx;
    background: #e5e7eb;
    z-index: 1;
  }
  
  .step-item.completed .step-line {
    background: #10b981;
  }
  
  /* 步骤1样式 */
  .step-section {
    padding: 0 30rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .step-header {
    margin-bottom: 40rpx;
  }
  
  .step-header .step-title {
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2937;
    display: block;
    margin-bottom: 12rpx;
  }
  
  .step-header .step-desc {
    font-size: 28rpx;
    color: #6b7280;
    line-height: 1.5;
  }
  
  /* 上传网格 */
  .upload-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24rpx;
    margin-bottom: 40rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .upload-card {
    background: white;
    border-radius: 20rpx;
    padding: 40rpx 24rpx;
    text-align: center;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
    border: 2rpx solid #e5e7eb;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }
  
  .upload-card:active {
    transform: translateY(-4rpx);
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  }
  
  .upload-card.uploaded {
    border-color: #10b981;
    background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
  }
  
  .upload-card-icon {
    font-size: 56rpx;
    margin-bottom: 20rpx;
    opacity: 0.8;
  }
  
  .upload-card.uploaded .upload-card-icon {
    opacity: 1;
  }
  
  .upload-card-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 12rpx;
  }
  
  .upload-card-status {
    font-size: 24rpx;
    color: #9ca3af;
    display: block;
    margin-bottom: 8rpx;
  }
  
  .upload-card.uploaded .upload-card-status {
    color: #10b981;
    font-weight: 500;
  }
  
  .upload-card-info {
    margin-top: 8rpx;
  }
  
  .upload-card-size {
    font-size: 20rpx;
    color: #6b7280;
    background: #f3f4f6;
    padding: 4rpx 12rpx;
    border-radius: 10rpx;
  }
  
  /* 上传提示卡片 */
  .upload-tip-card {
    grid-column: span 2;
    background: linear-gradient(135deg, #fef3c7, #fef3c7);
    border-radius: 20rpx;
    padding: 32rpx;
    display: flex;
    align-items: flex-start;
    gap: 24rpx;
    border: 2rpx solid #fbbf24;
    width: 100%;
    box-sizing: border-box;
  }
  
  .upload-tip-icon {
    font-size: 48rpx;
    flex-shrink: 0;
  }
  
  .upload-tip-content {
    flex: 1;
  }
  
  .upload-tip-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #92400e;
    margin-bottom: 16rpx;
  }
  
  .upload-tip-desc {
    display: block;
    font-size: 24rpx;
    color: #92400e;
    opacity: 0.8;
    margin-bottom: 8rpx;
    line-height: 1.4;
  }
  
  /* 竖向排列预览区域 - 新增样式 */
  .preview-section-vertical {
    background: white;
    border-radius: 20rpx;
    padding: 32rpx;
    margin-bottom: 40rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
    width: 100%;
    box-sizing: border-box;
  }
  
  .preview-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2937;
    margin-bottom: 24rpx;
    display: block;
  }
  
  .preview-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
  }
  
  .preview-row {
    display: flex;
    align-items: center;
    gap: 20rpx;
    padding: 20rpx;
    background: #f9fafb;
    border-radius: 16rpx;
    border: 1rpx solid #f1f5f9;
    transition: all 0.3s ease;
  }
  
  .preview-row:active {
    background: #f3f4f6;
  }
  
  .preview-image-vertical {
    width: 120rpx;
    height: 120rpx;
    border-radius: 12rpx;
    border: 2rpx solid #e5e7eb;
    flex-shrink: 0;
  }
  
  .preview-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8rpx;
  }
  
  .preview-label-vertical {
    font-size: 28rpx;
    color: #1f2937;
    font-weight: 500;
  }
  
  .preview-size {
    font-size: 24rpx;
    color: #6b7280;
  }
  
  .preview-arrow {
    font-size: 32rpx;
    color: #9ca3af;
    margin-left: auto;
  }
  
  /* 进度指示器 */
  .progress-indicator {
    background: white;
    border-radius: 20rpx;
    padding: 32rpx;
    margin-bottom: 32rpx;
    display: flex;
    align-items: center;
    gap: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  }
  
  .progress-text {
    font-size: 26rpx;
    color: #6b7280;
    font-weight: 500;
    white-space: nowrap;
  }
  
  .progress-bar {
    flex: 1;
    height: 12rpx;
    background: #f3f4f6;
    border-radius: 6rpx;
    overflow: hidden;
  }
  
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #10b981, #34d399);
    border-radius: 6rpx;
    transition: width 0.3s ease;
  }
  
  .progress-count {
    font-size: 28rpx;
    font-weight: 600;
    color: #10b981;
    white-space: nowrap;
  }
  
  /* 提交按钮 */
  .submit-section {
    margin-top: 40rpx;
  }
  
  .submit-btn {
    background: linear-gradient(135deg, #9ca3af, #d1d5db);
    border: none;
    border-radius: 20rpx;
    padding: 0;
    height: 96rpx;
    transition: all 0.3s ease;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .submit-btn::after {
    border: none;
  }
  
  .submit-btn.active {
    background: linear-gradient(135deg, #007AFF, #00B2FF);
    box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.3);
  }
  
  .submit-btn:active.active {
    transform: translateY(2rpx);
    box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
  }
  
  .submit-btn-content {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 16rpx;
    width: 100%;
    padding: 0 40rpx;
    box-sizing: border-box;
    text-align: center;
  }
  
  .submit-btn-icon {
    font-size: 36rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 36rpx;
    flex-shrink: 0;
  }
  
  .submit-btn-text {
    font-size: 32rpx;
    font-weight: 600;
    color: white;
    text-align: center;
    white-space: nowrap;
    line-height: 1.2;
  }
  
  .submit-btn.reviewing {
    opacity: 0.8;
  }
  
  .loading-spinner {
    width: 32rpx;
    height: 32rpx;
    border: 4rpx solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    flex-shrink: 0;
    margin: 0;
  }
  
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  
  .submit-tips {
    margin-top: 20rpx;
    text-align: center;
  }
  
  .submit-tip {
    font-size: 24rpx;
    color: #6b7280;
  }
  
  .reviewing-tip {
    font-size: 24rpx;
    color: #f59e0b;
  }
  
  /* 步骤2样式 */
  .progress-section {
    padding: 0 30rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .progress-header {
    text-align: center;
    margin-bottom: 60rpx;
  }
  
  .progress-icon {
    font-size: 80rpx;
    margin-bottom: 24rpx;
    opacity: 0.8;
  }
  
  .progress-header .progress-title {
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2937;
    display: block;
    margin-bottom: 12rpx;
  }
  
  .progress-header .progress-desc {
    font-size: 28rpx;
    color: #6b7280;
    line-height: 1.5;
  }
  
  .progress-container {
    display: flex;
    align-items: center;
    gap: 60rpx;
    margin-bottom: 60rpx;
  }
  
  .progress-visual {
    flex-shrink: 0;
  }
  
  .progress-circle {
    width: 200rpx;
    height: 200rpx;
    border-radius: 50%;
    background: #f3f4f6;
    position: relative;
    overflow: hidden;
  }
  
  .progress-circle-fill {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: conic-gradient(#007AFF 0%, #00B2FF 100%);
    clip-path: polygon(50% 50%, 50% 0%, 100% 0%, 100% 100%, 0% 100%, 0% 50%);
    transform-origin: center;
  }
  
  .progress-circle-inner {
    position: absolute;
    top: 20rpx;
    left: 20rpx;
    right: 20rpx;
    bottom: 20rpx;
    background: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .progress-percent {
    font-size: 40rpx;
    font-weight: 700;
    color: #007AFF;
  }
  
  .progress-details {
    flex: 1;
  }
  
  .current-task {
    font-size: 32rpx;
    color: #1f2937;
    font-weight: 600;
    margin-bottom: 32rpx;
    display: block;
    line-height: 1.4;
  }
  
  .progress-stages {
    display: flex;
    flex-direction: column;
    gap: 24rpx;
  }
  
  .progress-stage {
    font-size: 26rpx;
    color: #9ca3af;
    padding-left: 40rpx;
    position: relative;
  }
  
  .progress-stage::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 24rpx;
    height: 24rpx;
    border-radius: 50%;
    background: #e5e7eb;
    border: 3rpx solid #f3f4f6;
  }
  
  .progress-stage.completed {
    color: #10b981;
  }
  
  .progress-stage.completed::before {
    background: #10b981;
    border-color: #d1fae5;
  }
  
  .progress-tip {
    background: linear-gradient(135deg, #fef3c7, #fef3c7);
    border-radius: 20rpx;
    padding: 32rpx;
    display: flex;
    align-items: flex-start;
    gap: 24rpx;
    border: 2rpx solid #fbbf24;
  }
  
  .tip-icon {
    font-size: 48rpx;
    flex-shrink: 0;
  }
  
  .tip-content {
    flex: 1;
  }
  
  .tip-title {
    display: block;
    font-size: 28rpx;
    font-weight: 600;
    color: #92400e;
    margin-bottom: 8rpx;
  }
  
  .tip-desc {
    font-size: 26rpx;
    color: #92400e;
    opacity: 0.8;
    line-height: 1.4;
  }
  
  /* 步骤3样式 */
  .result-section {
    padding: 0 30rpx;
    width: 100%;
    box-sizing: border-box;
  }
  
  .result-header {
    background: white;
    border-radius: 24rpx;
    padding: 48rpx 32rpx 32rpx;
    text-align: center;
    margin-bottom: 32rpx;
    position: relative;
    overflow: hidden;
    box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  }
  
  .result-header.passed {
    border-top: 8rpx solid #10b981;
  }
  
  .result-header.failed {
    border-top: 8rpx solid #ef4444;
  }
  
  .result-icon-circle {
    width: 100rpx;
    height: 100rpx;
    border-radius: 50%;
    margin: 0 auto 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .result-header.passed .result-icon-circle {
    background: linear-gradient(135deg, #10b981, #34d399);
  }
  
  .result-header.failed .result-icon-circle {
    background: linear-gradient(135deg, #ef4444, #f87171);
  }
  
  .result-icon {
    font-size: 48rpx;
    color: white;
    font-weight: bold;
  }
  
  .result-title {
    font-size: 40rpx;
    font-weight: 700;
    color: #1f2937;
    display: block;
    margin-bottom: 16rpx;
  }
  
  .result-summary {
    font-size: 28rpx;
    color: #6b7280;
    line-height: 1.5;
    display: block;
    max-width: 80%;
    margin: 0 auto;
  }
  
  .result-ribbon {
    position: absolute;
    top: 32rpx;
    right: -40rpx;
    background: #10b981;
    color: white;
    padding: 12rpx 40rpx;
    font-size: 24rpx;
    font-weight: 600;
    transform: rotate(45deg);
    box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
  }
  
  /* 详细结果区域 */
  .detail-section {
    background: white;
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 32rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
  }
  
  .section-title {
    margin-bottom: 32rpx;
  }
  
  .title-text {
    font-size: 32rpx;
    font-weight: 700;
    color: #1f2937;
    display: block;
    margin-bottom: 8rpx;
  }
  
  .title-sub {
    font-size: 24rpx;
    color: #6b7280;
    display: block;
  }
  
  .detail-list {
    display: flex;
    flex-direction: column;
    gap: 20rpx;
  }
  
  .detail-item {
    display: flex;
    align-items: flex-start;
    gap: 24rpx;
    padding: 28rpx;
    border-radius: 16rpx;
    border-left: 6rpx solid;
  }
  
  .detail-item.passed {
    border-left-color: #10b981;
    background: linear-gradient(135deg, #f0fdf4, #ecfdf5);
  }
  
  .detail-item.failed {
    border-left-color: #ef4444;
    background: linear-gradient(135deg, #fef2f2, #fef2f2);
  }
  
  .detail-icon {
    font-size: 40rpx;
    flex-shrink: 0;
    opacity: 0.8;
  }
  
  .detail-content {
    flex: 1;
  }
  
  .detail-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12rpx;
  }
  
  .detail-type {
    font-size: 28rpx;
    font-weight: 600;
    color: #1f2937;
  }
  
  .detail-status {
    display: flex;
    align-items: center;
    gap: 8rpx;
    padding: 6rpx 16rpx;
    border-radius: 20rpx;
    font-size: 22rpx;
    font-weight: 500;
  }
  
  .detail-status.passed {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
  }
  
  .detail-status.failed {
    background: rgba(239, 68, 68, 0.1);
    color: #ef4444;
  }
  
  .status-dot {
    width: 8rpx;
    height: 8rpx;
    border-radius: 50%;
  }
  
  .detail-status.passed .status-dot {
    background: #10b981;
  }
  
  .detail-status.failed .status-dot {
    background: #ef4444;
  }
  
  .detail-reason {
    font-size: 26rpx;
    color: #6b7280;
    display: block;
    margin-bottom: 8rpx;
    line-height: 1.4;
  }
  
  .detail-suggestion {
    font-size: 24rpx;
    color: #f59e0b;
    display: block;
    line-height: 1.4;
  }
  
  /* 建议卡片 */
  .suggestion-card {
    background: linear-gradient(135deg, #f0f9ff, #e0f2fe);
    border-radius: 20rpx;
    padding: 32rpx;
    margin-bottom: 40rpx;
    border: 2rpx solid #0ea5e9;
  }
  
  .suggestion-header {
    display: flex;
    align-items: center;
    gap: 16rpx;
    margin-bottom: 20rpx;
  }
  
  .suggestion-icon {
    font-size: 36rpx;
  }
  
  .suggestion-title {
    font-size: 28rpx;
    font-weight: 600;
    color: #0369a1;
  }
  
  .suggestion-content {
    font-size: 26rpx;
    color: #0369a1;
    line-height: 1.5;
    opacity: 0.9;
  }
  
  /* 操作按钮 */
  .action-buttons {
    display: flex;
    gap: 24rpx;
  }
  
  .action-btn {
    flex: 1;
    border: none;
    border-radius: 16rpx;
    padding: 28rpx 32rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12rpx;
    font-size: 28rpx;
    font-weight: 600;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .action-btn::after {
    border: none;
  }
  
  .restart-btn {
    background: linear-gradient(135deg, #f3f4f6, #e5e7eb);
    color: #374151;
  }
  
  .restart-btn:active {
    transform: translateY(2rpx);
    background: linear-gradient(135deg, #e5e7eb, #d1d5db);
  }
  
  .save-btn {
    background: linear-gradient(135deg, #007AFF, #00B2FF);
    color: white;
    box-shadow: 0 6rpx 20rpx rgba(0, 122, 255, 0.3);
  }
  
  .save-btn:active {
    transform: translateY(2rpx);
    box-shadow: 0 3rpx 10rpx rgba(0, 122, 255, 0.3);
  }
  
  .btn-icon {
    font-size: 32rpx;
  }
  
  /* 不同评级的颜色定义 */
  .rating-excellent {
    background-color: #10b981;
  }
  
  .rating-good {
    background-color: #3b82f6;
  }
  
  .rating-medium {
    background-color: #f59e0b;
  }
  
  .rating-poor {
    background-color: #ef4444;
  }

/* 评级显示样式 */
.rating-display {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 30rpx auto 20rpx;
    gap: 16rpx;
  }
  
  .rating-label {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.15);
    border: 4rpx solid white;
  }
  
  .rating-text {
    font-size: 32rpx;
    font-weight: 800;
    color: white;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  }
  
  .score-display {
    display: flex;
    align-items: baseline;
    gap: 8rpx;
    margin-top: 8rpx;
  }
  
  .score-number {
    font-size: 44rpx;
    font-weight: 800;
    color: #1f2937;
    line-height: 1;
  }
  
  .score-unit {
    font-size: 26rpx;
    color: #6b7280;
    font-weight: 600;
  }
  
  /* 评级描述文字 */
  .rating-desc {
    font-size: 24rpx;
    color: #6b7280;
    margin-top: 8rpx;
    text-align: center;
  }
  
  .rating-level {
    font-weight: 600;
  }
  
  .rating-range {
    margin-left: 8rpx;
    opacity: 0.8;
  }
  /* 响应式设计 */
  @media (max-width: 750rpx) {
    .upload-grid {
      grid-template-columns: 1fr;
    }
    
    .upload-tip-card {
      grid-column: span 1;
    }
    
    .progress-container {
      flex-direction: column;
      gap: 40rpx;
    }
    
    .action-buttons {
      flex-direction: column;
    }
  }

