/* 页面容器 */
.container {
    min-height: 100vh;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    padding: 30rpx;
  }
  
  /* 用户信息卡片 - 大幅美化 */
  .user-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 24rpx;
    padding: 40rpx;
    margin-bottom: 40rpx;
    box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.3);
    position: relative;
    overflow: hidden;
  }
  
  .user-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px);
    background-size: 20rpx 20rpx;
    opacity: 0.5;
  }
  
  .user-info {
    display: flex;
    align-items: center;
    margin-bottom: 30rpx;
  }
  
  .user-avatar {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.3);
    margin-right: 30rpx;
  }
  
  .user-details {
    flex: 1;
  }
  
  .user-greeting {
    display: block;
    font-size: 28rpx;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 8rpx;
  }
  
  .user-nickname {
    display: block;
    font-size: 40rpx;
    font-weight: bold;
    color: white;
    margin-bottom: 8rpx;
  }
  
  .user-welcome {
    display: block;
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.7);
  }
  
  .user-stats {
    display: flex;
    justify-content: space-around;
    border-top: 1rpx solid rgba(255, 255, 255, 0.2);
    padding-top: 30rpx;
  }
  
  .stat-item {
    text-align: center;
  }
  
  .stat-number {
    display: block;
    font-size: 36rpx;
    font-weight: bold;
    color: white;
    margin-bottom: 8rpx;
  }
  
  .stat-label {
    display: block;
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.7);
  }
  
  /* 功能网格区域 */
  .functions-grid {
    margin-bottom: 40rpx;
  }
  
  .grid-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #2c3e50;
    margin-bottom: 30rpx;
    padding-left: 20rpx;
    position: relative;
  }
  
  .grid-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 8rpx;
    height: 36rpx;
    background: linear-gradient(135deg, #4CAF50, #45a049);
    border-radius: 4rpx;
  }
  
  .grid-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24rpx;
  }
  
  /* 功能卡片 - 大幅美化 */
  .function-card {
    background: white;
    border-radius: 20rpx;
    padding: 40rpx 30rpx;
    text-align: center;
    position: relative;
    transition: all 0.3s ease;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
    border: 1rpx solid rgba(0, 0, 0, 0.05);
  }
  
  .function-card:active {
    transform: translateY(4rpx);
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.12);
  }
  
  .card-icon {
    font-size: 80rpx;
    margin-bottom: 20rpx;
    display: block;
    transition: transform 0.3s ease;
  }
  
  .function-card:active .card-icon {
    transform: scale(1.1);
  }
  
  /* 不同功能的图标颜色 */
  .card-icon.responsibility { color: #3498db; }
  .card-icon.qualification { color: #e74c3c; }
  .card-icon.support { color: #9b59b6; }
  .card-icon.report { color: #e67e22; }
  
  .card-title {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 12rpx;
  }
  
  .card-desc {
    display: block;
    font-size: 24rpx;
    color: #7f8c8d;
    line-height: 1.4;
  }
  
  .card-badge {
    position: absolute;
    top: 20rpx;
    right: 20rpx;
    background: #e74c3c;
    color: white;
    padding: 8rpx 16rpx;
    border-radius: 20rpx;
    font-size: 20rpx;
    font-weight: bold;
  }
  
  .card-badge.urgent {
    background: linear-gradient(135deg, #e74c3c, #c0392b);
  }
  
  /* 平台公告区域 */
  .announcement {
    background: white;
    border-radius: 20rpx;
    padding: 30rpx;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  }
  
  .announcement-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
  }
  
  .announcement-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #2c3e50;
  }
  
  .announcement-more {
    font-size: 24rpx;
    color: #4CAF50;
  }
  
  .announcement-content {
    background: #f8f9fa;
    border-radius: 12rpx;
    padding: 24rpx;
  }
  
  .announcement-text {
    font-size: 26rpx;
    color: #5a6c7d;
    line-height: 1.5;
  }
  
  /* 响应式设计 */
  @media (max-width: 375px) {
    .container {
      padding: 20rpx;
    }
    
    .grid-container {
      grid-template-columns: 1fr;
      gap: 20rpx;
    }
  }