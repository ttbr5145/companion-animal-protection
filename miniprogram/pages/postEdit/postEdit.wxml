<view class="container">
  <!-- 顶部类型提示 -->
  <view class="type-indicator {{postType}}">
    <text class="type-text">正在发布：{{typeText}}</text>
  </view>

  <!-- 表单区域 -->
  <view class="form-container">
    <!-- 标题输入 -->
    <view class="form-group">
      <input class="title-input" 
             value="{{title}}" 
             placeholder="请输入标题（必填）" 
             maxlength="30"
             bindinput="onTitleInput" />
    </view>

    <!-- 内容编辑 -->
    <view class="form-group">
      <textarea class="content-textarea" 
                value="{{content}}" 
                placeholder="请详细描述您的情况...（必填）" 
                maxlength="500"
                show-confirm-bar="{{false}}"
                bindinput="onContentInput" />
      <text class="word-count">{{content.length}}/500</text>
    </view>

    <!-- 图片上传 -->
    <view class="form-group">
      <text class="section-label">添加图片（可选，最多3张）</text>
      <view class="image-upload-section">
        <view class="image-list">
          <block wx:for="{{images}}" wx:key="index">
            <view class="image-item">
              <image class="preview-image" src="{{item}}" mode="aspectFill"></image>
              <view class="image-remove" bindtap="removeImage" data-index="{{index}}">×</view>
            </view>
          </block>
          <view class="image-upload-btn" wx:if="{{images.length < 3}}" bindtap="chooseImage">
            <text class="upload-icon">+</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 位置信息 -->
    <view class="form-group">
      <text class="section-label">位置信息（可选）</text>
      <view class="location-section" bindtap="chooseLocation">
        <text class="location-text">{{location.name || '点击选择位置'}}</text>
        <text class="location-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <button class="btn-cancel" bindtap="onCancel">取消</button>
    <button class="btn-submit" bindtap="onSubmit" disabled="{{!canSubmit}}">发布</button>
  </view>
</view>

<!-- 加载提示 -->
<view class="loading-mask" wx:if="{{isLoading}}">
  <view class="loading-content">
    <view class="loading-spinner"></view>
    <text class="loading-text">发布中...</text>
  </view>
</view>