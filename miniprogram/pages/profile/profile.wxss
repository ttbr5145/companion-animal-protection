/* 页面容器 */
.container {
    min-height: 100vh;
    background: #f5f5f5;
    padding-bottom: 120rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 20rpx; /* 添加顶部内边距，整体下移 */
}

/* 顶部用户信息区域 - 黄色背景 */
.user-header {
    background: linear-gradient(135deg, #FFD700, #FFA500);
    padding: 80rpx 0 40rpx; /* 增加顶部内边距为80rpx，整体下移 */
    border-radius: 30rpx 30rpx 30rpx 30rpx;
    box-shadow: 0 4rpx 20rpx rgba(255, 165, 0, 0.3);
    width: 90%;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 20rpx; /* 添加顶部外边距，进一步下移 */
    position: relative;
    z-index: 10; /* 确保在顶部 */
}

.user-info-section {
    display: flex;
    align-items: center;
    margin-bottom: 50rpx;
    width: 85%; /* 设置为屏幕宽度的85% */
}

.user-avatar {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.5);
    margin-right: 30rpx;
}

.user-details {
    flex: 1;
}

.user-nickname {
    display: block;
    font-size: 40rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
}

.user-level {
    display: block;
    font-size: 24rpx;
    color: #666;
    background: rgba(255, 255, 255, 0.7);
    padding: 8rpx 20rpx;
    border-radius: 20rpx;
    width: fit-content;
}

.checkin-btn {
    background: rgba(255, 255, 255, 0.9);
    color: #FFA500;
    border: none;
    border-radius: 30rpx;
    padding: 20rpx 40rpx;
    font-size: 28rpx;
    font-weight: bold;
    box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
}

.checkin-btn:active {
    background: rgba(255, 255, 255, 1);
    transform: scale(0.95);
}

/* 数据统计区域 */
.stats-section {
    display: flex;
    justify-content: space-around;
    background: rgba(255, 255, 255, 0.9);
    border-radius: 20rpx;
    padding: 30rpx 0;
    box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
    width: 85%; /* 设置为屏幕宽度的75% */
}

.stat-item {
    text-align: center;
    flex: 1;
}

.stat-number {
    display: block;
    font-size: 48rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 8rpx;
}

.stat-label {
    display: block;
    font-size: 24rpx;
    color: #666;
}

/* 志愿者注册横幅 */
.volunteer-banner {
    background: linear-gradient(135deg, #4CAF50, #45a049);
    margin: 30rpx 0; /* 调整左右边距为0 */
    border-radius: 20rpx;
    padding: 30rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 4rpx 15rpx rgba(76, 175, 80, 0.3);
    color: white;
    width: 75%; /* 设置为屏幕宽度的75% */
}

.volunteer-content {
    flex: 1;
}

.volunteer-title {
    display: block;
    font-size: 32rpx;
    font-weight: bold;
    margin-bottom: 8rpx;
}

.volunteer-desc {
    display: block;
    font-size: 24rpx;
    opacity: 0.9;
}

.volunteer-action {
    display: flex;
    align-items: center;
}

.volunteer-action-text {
    font-size: 24rpx;
    margin-right: 10rpx;
}

.arrow {
    font-size: 36rpx;
}

/* 图标导航网格 */
.icon-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    background: white;
    margin: 0 0 30rpx; /* 调整左右边距为0 */
    border-radius: 20rpx;
    padding: 30rpx 0;
    box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
    width: 90%; /* 设置为屏幕宽度的75% */
}

.grid-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20rpx 0;
}

.grid-icon {
    font-size: 60rpx;
    margin-bottom: 20rpx;
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8f9fa;
    transition: all 0.3s ease;
}

.grid-item:active .grid-icon {
    transform: scale(1.1);
    background: #FFD700;
}

.grid-text {
    font-size: 24rpx;
    color: #333;
    text-align: center;
}

/* 功能列表 - 全屏宽度 */
.function-list {
    margin: 0; /* 调整左右边距为0 */
    width: 90%; /* 设置为屏幕宽度的75% */
}

.list-section {
    background: white;
    border-radius: 20rpx;
    margin-bottom: 30rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08);
    width: 100%; /* 占满父容器宽度 */
}

/* 全屏宽度列表项 */
.list-item.full-width {
    display: flex;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
    position: relative;
    width: 100%;
    box-sizing: border-box;
}

.list-item:last-child {
    border-bottom: none;
}

.list-item:active {
    background: #f8f9fa;
}

.item-icon {
    font-size: 40rpx;
    margin-right: 20rpx;
    width: 60rpx;
    text-align: center;
}

.item-text {
    flex: 1;
    font-size: 28rpx;
    color: #333;
}

.item-arrow {
    font-size: 36rpx;
    color: #ccc;
}

/* 退出登录按钮 - 75%宽度居中版本 */
.logout-section {
    margin: 40rpx 0 20rpx;
    padding: 0;
    display: flex;
    justify-content: center; /* 水平居中 */
    width: 100%;
}

.logout-btn {
    width: 75%; /* 设置为屏幕宽度的75% */
    height: 100rpx;
    background: transparent;
    color: #ff6b6b;
    border: 3rpx solid #ff6b6b;
    border-radius: 8rpx;
    font-size: 34rpx;
    font-weight: 600;
    box-shadow: none;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    display: flex;
    align-items: center;
    justify-content: center;
    letter-spacing: 2rpx;
    white-space: nowrap;
}

/* 悬停效果 */
.logout-btn:hover {
    background: rgba(255, 107, 107, 0.05);
}

.logout-btn:active {
    background: rgba(255, 107, 107, 0.12);
    border-color: #e74c3c;
    transform: scale(0.98);
}

/* 添加边框动画效果 */
.logout-btn::before {
    content: '';
    position: absolute;
    top: -3rpx;
    left: -3rpx;
    right: -3rpx;
    bottom: -3rpx;
    border: 3rpx solid transparent;
    border-radius: 8rpx;
    background: linear-gradient(45deg, #ff6b6b, #e74c3c, #ff6b6b) border-box;
    -webkit-mask: 
        linear-gradient(#fff 0 0) padding-box, 
        linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
}

.logout-btn:active::before {
    opacity: 1;
    animation: border-glow 1.5s ease-in-out;
}

@keyframes border-glow {
    0%, 100% {
        opacity: 0;
    }
    50% {
        opacity: 1;
    }
}

/* 版本信息 */
.version-info {
    text-align: center;
    margin: 20rpx 0;
    width: 75%; /* 设置为屏幕宽度的75% */
}

.version-text {
    font-size: 24rpx;
    color: #999;
}

/* 底部TabBar占位 */
.tabbar-placeholder {
    height: 120rpx;
}

/* 模态框样式 */
.modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
}

.modal-mask {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
}

.modal-content {
    background: white;
    border-radius: 20rpx;
    width: 600rpx;
    z-index: 1001;
    box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.2);
    max-width: 80%; /* 防止模态框过宽 */
}

.modal-header {
    padding: 40rpx 40rpx 20rpx;
    text-align: center;
}

.modal-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
}

.modal-body {
    padding: 20rpx 40rpx;
    text-align: center;
}

.modal-text {
    font-size: 28rpx;
    color: #666;
    line-height: 1.5;
}

.modal-footer {
    display: flex;
    padding: 30rpx 40rpx 40rpx;
    gap: 20rpx;
}

.modal-btn {
    flex: 1;
    height: 80rpx;
    border-radius: 40rpx;
    font-size: 28rpx;
    border: none;
}

.modal-btn.cancel {
    background: #f8f9fa;
    color: #666;
}

.modal-btn.confirm {
    background: linear-gradient(135deg, #ff6b6b, #ee5a52);
    color: white;
}

/* 打卡成功提示 */
.checkin-toast {
    position: fixed;
    top: 200rpx;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 20rpx 40rpx;
    border-radius: 40rpx;
    z-index: 1000;
}

.checkin-text {
    font-size: 28rpx;
}