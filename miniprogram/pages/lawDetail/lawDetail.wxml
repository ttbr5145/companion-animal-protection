<view class="detail-container">
    <!-- 头部信息 -->
    <view class="detail-header">
        <view class="header-content">
            <text class="law-title">{{lawDetail.lawName || '法规详情'}}</text>
            
            <!-- 元信息网格布局 -->
            <view class="meta-grid">
                <view class="meta-item">
                    <text class="meta-label">发布机关</text>
                    <text class="meta-value">{{lawDetail.issuingOrgan}}</text>
                </view>
                <view class="meta-item">
                    <text class="meta-label">文号</text>
                    <text class="meta-value">{{lawDetail.filenum}}</text>
                </view>
                <view class="meta-item">
                    <text class="meta-label">时效性</text>
                    <text class="meta-value {{lawDetail.timeliness === '现行有效' ? 'valid' : 'invalid'}}">
                        {{lawDetail.timeliness}}
                    </text>
                </view>
                <view class="meta-item">
                    <text class="meta-label">发布日期</text>
                    <text class="meta-value">{{lawDetail.releaseDate}}</text>
                </view>
                <view class="meta-item">
                    <text class="meta-label">实施日期</text>
                    <text class="meta-value">{{lawDetail.implementDate}}</text>
                </view>
            </view>
        </view>
    </view>
    
    <!-- 加载状态 -->
    <view wx:if="{{isLoading}}" class="loading-state">
        <view class="loading-spinner"></view>
        <text>加载中...</text>
    </view>
    
    <!-- 错误状态 -->
    <view wx:elif="{{loadError}}" class="error-state">
        <text class="error-icon">⚠️</text>
        <text class="error-title">加载失败</text>
        <text class="error-message">{{loadError}}</text>
        <button class="retry-btn" bindtap="onRetry">重新加载</button>
    </view>
    
    <!-- 内容区域 -->
    <view wx:else class="content-area">
        <!-- 法规正文 -->
        <view class="content-section">
            <view class="section-header">
                <text class="section-title">法规正文</text>
                <button class="copy-btn" bindtap="onCopyContent">复制内容</button>
            </view>
            <scroll-view class="content-scroll" scroll-y>
                <text class="content-text" selectable>{{lawDetail.content || '暂无内容'}}</text>
            </scroll-view>
        </view>
        
        <!-- 试用版提示 -->
        <view class="tip-section" wx:if="{{lawDetail.content && lawDetail.content.includes('试用版')}}">
            <text class="tip-icon">💡</text>
            <text class="tip-text">当前为试用版接口，完整内容请访问法律之星官网</text>
        </view>
    </view>
    
    <!-- 底部操作栏 -->
    <view class="action-bar" wx:if="{{!isLoading && !loadError}}">
        <button class="action-btn secondary" bindtap="onGoBack">返回</button>
        <button class="action-btn primary" bindtap="onCopyAll">复制全文</button>
        <button class="action-btn primary" bindtap="onShare" open-type="share">分享</button>
    </view>
</view>