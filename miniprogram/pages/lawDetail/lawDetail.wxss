.detail-container {
    min-height: 100vh;
    background: #f8f9fa;
}

/* 头部样式 */
.detail-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 30rpx;
    color: white;
}

.law-title {
    display: block;
    font-size: 36rpx;
    font-weight: bold;
    line-height: 1.4;
    margin-bottom: 30rpx;
    text-align: center;
}

/* 元信息网格布局 */
.meta-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20rpx;
    background: rgba(255,255,255,0.1);
    padding: 20rpx;
    border-radius: 10rpx;
    backdrop-filter: blur(10px);
}

.meta-item {
    display: flex;
    flex-direction: column;
}

.meta-label {
    font-size: 22rpx;
    opacity: 0.8;
    margin-bottom: 5rpx;
}

.meta-value {
    font-size: 24rpx;
    font-weight: 500;
}

.meta-value.valid {
    color: #4CAF50;
}

.meta-value.invalid {
    color: #ff6b6b;
}

/* 内容区域 */
.content-area {
    padding: 30rpx;
}

.content-section {
    background: white;
    border-radius: 15rpx;
    box-shadow: 0 2rpx 20rpx rgba(0,0,0,0.1);
    overflow: hidden;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx 30rpx 20rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.section-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.copy-btn {
    background: #2196F3;
    color: white;
    border: none;
    border-radius: 6rpx;
    padding: 10rpx 20rpx;
    font-size: 22rpx;
}

.content-scroll {
    max-height: 60vh;
    padding: 0 30rpx 30rpx;
}

.content-text {
    font-size: 28rpx;
    line-height: 1.8;
    color: #333;
    white-space: pre-wrap;
    word-break: break-word;
}

/* 试用版提示 */
.tip-section {
    background: #fff3cd;
    border: 1rpx solid #ffeaa7;
    border-radius: 10rpx;
    padding: 20rpx;
    margin-top: 20rpx;
    display: flex;
    align-items: flex-start;
    gap: 15rpx;
}

.tip-icon {
    font-size: 32rpx;
    flex-shrink: 0;
}

.tip-text {
    font-size: 24rpx;
    color: #856404;
    line-height: 1.4;
    flex: 1;
}

/* 底部操作栏 */
.action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    padding: 20rpx 30rpx;
    display: flex;
    gap: 20rpx;
    border-top: 1rpx solid #e0e0e0;
    box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.1);
}

.action-btn {
    flex: 1;
    border: none;
    border-radius: 10rpx;
    padding: 25rpx;
    font-size: 28rpx;
    transition: all 0.3s;
}

.action-btn:active {
    transform: scale(0.98);
}

.action-btn.primary {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
}

.action-btn.secondary {
    background: #f8f9fa;
    color: #666;
    border: 1rpx solid #e0e0e0;
}

/* 加载和错误状态 */
.loading-state {
    text-align: center;
    padding: 100rpx 30rpx;
    color: #666;
}

.loading-spinner {
    width: 60rpx;
    height: 60rpx;
    border: 4rpx solid #f3f3f3;
    border-top: 4rpx solid #667eea;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin: 0 auto 20rpx;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

.error-state {
    text-align: center;
    padding: 100rpx 30rpx;
    background: white;
    margin: 20rpx;
    border-radius: 15rpx;
}

.error-icon {
    font-size: 80rpx;
    display: block;
    margin-bottom: 20rpx;
}

.error-title {
    display: block;
    font-size: 32rpx;
    color: #f44336;
    margin-bottom: 10rpx;
    font-weight: bold;
}

.error-message {
    display: block;
    font-size: 28rpx;
    color: #666;
    margin-bottom: 30rpx;
    line-height: 1.5;
}

.retry-btn {
    background: #667eea;
    color: white;
    border: none;
    border-radius: 8rpx;
    padding: 20rpx 40rpx;
    font-size: 28rpx;
}