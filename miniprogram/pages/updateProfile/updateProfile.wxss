.container {
    min-height: 100vh;
    background: #f5f5f5;
    padding-bottom: 40rpx;
  }
  
  /* 头部导航 */
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 40rpx 30rpx 30rpx;
    background: white;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .header-back {
    font-size: 48rpx;
    color: #4CAF50;
    font-weight: bold;
    padding: 10rpx 20rpx;
  }
  
  .header-title {
    font-size: 36rpx;
    font-weight: bold;
    color: #333;
  }
  
  .header-save {
    font-size: 32rpx;
    color: #4CAF50;
    font-weight: 500;
    padding: 10rpx 20rpx;
  }
  
  /* 头像区域 */
  .avatar-section {
    background: white;
    margin: 20rpx 30rpx;
    padding: 40rpx 30rpx;
    border-radius: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  }
  
  .section-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 30rpx;
  }
  
  .avatar-upload {
    position: relative;
    width: 160rpx;
    height: 160rpx;
    margin: 0 auto;
    border-radius: 50%;
    overflow: hidden;
  }
  
  .avatar-image {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 4rpx solid #f0f0f0;
  }
  
  .avatar-mask {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 24rpx;
    opacity: 0;
    transition: opacity 0.3s;
  }
  
  .avatar-upload:active .avatar-mask {
    opacity: 1;
  }
  
  /* 表单区域 */
  .form-section {
    background: white;
    margin: 20rpx 30rpx;
    padding: 40rpx 30rpx;
    border-radius: 20rpx;
    box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  }
  
  .form-item {
    display: flex;
    align-items: center;
    padding: 30rpx 0;
    border-bottom: 1rpx solid #f8f8f8;
  }
  
  .form-item:last-child {
    border-bottom: none;
  }
  
  .item-label {
    width: 200rpx;
    font-size: 28rpx;
    color: #666;
    font-weight: 500;
  }
  
  .item-input {
    flex: 1;
    font-size: 28rpx;
    color: #333;
    text-align: right;
    padding: 20rpx 0;
  }
  
  .item-picker {
    flex: 1;
    text-align: right;
  }
  
  .picker-value {
    font-size: 28rpx;
    color: #333;
    padding: 20rpx 0;
  }
  
  .picker-value:empty::before {
    content: '请选择';
    color: #ccc;
  }
  
  /* 文本域样式 */
  .textarea-item {
    align-items: flex-start;
  }
  
  .item-textarea {
    flex: 1;
    min-height: 120rpx;
    font-size: 28rpx;
    color: #333;
    padding: 20rpx;
    border: 1rpx solid #f0f0f0;
    border-radius: 10rpx;
    background: #fafafa;
  }
  
  .textarea-count {
    position: absolute;
    right: 30rpx;
    bottom: 20rpx;
    font-size: 24rpx;
    color: #999;
  }
  
  /* 保存按钮 */
  .save-section {
    margin: 40rpx 30rpx 20rpx;
  }
  
  .save-btn {
    width: 100%;
    height: 90rpx;
    background: linear-gradient(135deg, #4CAF50, #45a049);
    color: white;
    border: none;
    border-radius: 45rpx;
    font-size: 32rpx;
    font-weight: 600;
    box-shadow: 0 4rpx 15rpx rgba(76, 175, 80, 0.3);
  }
  
  .save-btn:active {
    transform: scale(0.98);
    box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.4);
  }
  
  /* 提示信息 */
  .toast {
    position: fixed;
    top: 200rpx;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 20rpx 40rpx;
    border-radius: 40rpx;
    z-index: 1000;
  }
  
  .toast-text {
    font-size: 28rpx;
  }
  
  /* 加载中 */
  .loading {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.9);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  
  .loading-spinner {
    width: 60rpx;
    height: 60rpx;
    border: 6rpx solid #f3f3f3;
    border-top: 6rpx solid #4CAF50;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 20rpx;
  }
  
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  
  .loading-text {
    font-size: 28rpx;
    color: #666;
  }