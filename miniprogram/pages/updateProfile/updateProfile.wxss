page {
    background-color: #ffffff; /* 白色背景 */
  }
  
  .container {
    min-height: 100vh;
    background: #ffffff; /* 确保容器也是白色 */
    padding-bottom: 40rpx;
  }
  
  
    /* 顶部导航栏 - 全屏宽度 */
    .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 80rpx 30rpx 30rpx;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    border-bottom: 1rpx solid #f0f0f0;
    position: relative;
    width: 100%; /* 全屏宽度 */
    box-sizing: border-box;
  }
  
  .header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.95);
    z-index: -1;
  }
  
  .header-back {
    font-size: 48rpx;
    color: #333; /* 深色更适合白色背景 */
    font-weight: bold;
    padding: 20rpx;
    background: rgba(0, 0, 0, 0.05); /* 浅灰色背景 */
    border-radius: 50%;
    width: 80rpx;
    height: 80rpx;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .header-title {
    font-size: 36rpx;
    font-weight: 600;
    color: #333; /* 深色文字 */
  }
  
  /* 内容区域 */
  .content-area {
    padding: 0 30rpx;
    margin-top: 30rpx;
  }
  
  /* 卡片样式优化以适应白色背景 */
    .profile-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 25rpx;
        padding: 40rpx 30rpx;
        margin-bottom: 30rpx;
        box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.08); /* 更柔和的阴影 */
        border: 1rpx solid rgba(0, 0, 0, 0.05);
    }
  
  .section-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 30rpx;
    display: flex;
    align-items: center;
  }
  
  .section-title::before {
    content: '';
    width: 8rpx;
    height: 32rpx;
    background: linear-gradient(135deg, #4CAF50, #2196F3);
    border-radius: 4rpx;
    margin-right: 15rpx;
  }
  
  /* 头像区域美化 */
  .avatar-section {
    text-align: center;
    padding: 40rpx 0;
  }
  
  .avatar-upload {
    position: relative;
    display: inline-block;
    width: 200rpx;
    height: 200rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #667eea, #764ba2);
    padding: 8rpx;
    box-shadow: 0 8rpx 25rpx rgba(102, 126, 234, 0.4);
  }
  
  .avatar-image {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    border: 4rpx solid white;
    box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
    background: #000000; /* 图片加载前的黑色背景 */
  }
  
  .avatar-mask {
    position: absolute;
    top: 8rpx;
    left: 8rpx;
    right: 8rpx;
    bottom: 8rpx;
    background: rgba(0, 0, 0, 0.7);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26rpx;
    opacity: 0;
    transition: all 0.3s ease;
    backdrop-filter: blur(5px);
  }
  
  .avatar-upload {
    position: relative;
    display: inline-block;
    width: 200rpx;
    height: 200rpx;
    border-radius: 50%;
    background: #000000; /* 黑色背景，无图时显示 */
    padding: 8rpx;
    box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.3);
  }
  
  /* 表单项目美化 */
    .form-item {
        display: flex;
        align-items: center;
        padding: 35rpx 0;
        border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
    }
  
  .form-item:last-child {
    border-bottom: none;
  }
  
  .form-item:active {
    background: rgba(76, 175, 80, 0.05);
    border-radius: 15rpx;
    transform: translateX(10rpx);
  }
  
  .item-label {
    width: 200rpx;
    font-size: 28rpx;
    color: #2c3e50;
    font-weight: 500;
    display: flex;
    align-items: center;
  }
  
  .item-label::before {
    content: '•';
    color: #4CAF50;
    margin-right: 15rpx;
    font-size: 40rpx;
  }
  
  .item-input {
    flex: 1;
    font-size: 28rpx;
    color: #34495e;
    text-align: right;
    padding: 25rpx 20rpx;
    background: rgba(245, 245, 245, 0.8);
    border-radius: 12rpx;
    border: 2rpx solid transparent;
    transition: all 0.3s ease;
  }
  
  .item-input:focus {
    border-color: #4CAF50;
    background: white;
    box-shadow: 0 0 20rpx rgba(76, 175, 80, 0.2);
  }
  
  .item-picker {
    flex: 1;
    text-align: right;
  }
  
  .picker-value {
    font-size: 28rpx;
    color: #34495e;
    padding: 25rpx 20rpx;
    background: rgba(245, 245, 245, 0.8);
    border-radius: 12rpx;
    border: 2rpx solid transparent;
    transition: all 0.3s ease;
  }
  
  .picker-value:empty::before {
    content: '请选择';
    color: #bdc3c7;
  }
  
  /* 文本域特殊样式 */
  .textarea-item {
    align-items: flex-start;
    flex-direction: column;
  }
  
  .item-textarea {
    width: 100%;
    min-height: 160rpx;
    font-size: 28rpx;
    color: #34495e;
    padding: 30rpx;
    border: 2rpx solid #ecf0f1;
    border-radius: 15rpx;
    background: rgba(245, 245, 245, 0.8);
    line-height: 1.6;
    transition: all 0.3s ease;
    box-sizing: border-box;
  }
  
  .item-textarea:focus {
    border-color: #4CAF50;
    background: white;
    box-shadow: 0 0 25rpx rgba(76, 175, 80, 0.2);
  }
  
  .textarea-count {
    align-self: flex-end;
    margin-top: 15rpx;
    font-size: 24rpx;
    color: #7f8c8d;
    background: rgba(52, 152, 219, 0.1);
    padding: 8rpx 20rpx;
    border-radius: 20rpx;
  }
  
  .save-btn {
    width: 85vw !important; /* 使用视口宽度，确保真正占满屏幕 */
    height: 100rpx;
    background: linear-gradient(135deg, #4CAF50, #45a049);
    color: white;
    border: none;
    border-radius: 50rpx; /* 如需直角按钮可设为0，如需圆角保持50rpx */
    font-size: 34rpx;
    font-weight: 600;
    box-shadow: none; /* 如需更简洁可去掉阴影 */
    margin: 0;
    padding: 0;
    position: relative;
    left: 0;
    right: 0;
  }
  
  /* 确保按钮容器也无边界 */
  .save-section {
    margin: 0 !important;
    padding: 0 !important;
    width: 85%;
  }
  
  /* 重要：去除小程序button所有默认样式 */
  .save-btn::after {
    display: none !important;
    border: none !important;
  }
  
  /* 提示信息美化 */
  .toast {
    position: fixed;
    top: 200rpx;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.85);
    color: white;
    padding: 25rpx 50rpx;
    border-radius: 50rpx;
    z-index: 1000;
    box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(10px);
    border: 1rpx solid rgba(255, 255, 255, 0.1);
  }
  
  .toast-text {
    font-size: 28rpx;
    font-weight: 500;
  }
  
  /* 加载中动画美化 */
  .loading {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.95);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    z-index: 1000;
    backdrop-filter: blur(10px);
  }
  
  .loading-spinner {
    width: 80rpx;
    height: 80rpx;
    border: 6rpx solid #f1f2f6;
    border-top: 6rpx solid #4CAF50;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 30rpx;
    box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.1);
  }
  
  .loading-text {
    font-size: 30rpx;
    color: #2c3e50;
    font-weight: 500;
  }
  
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  
  /* 响应式设计 */
  @media (max-width: 375px) {
    .content-area {
      padding: 0 20rpx;
    }
    
    .profile-card {
      padding: 30rpx 20rpx;
    }
    
    .avatar-upload {
      width: 180rpx;
      height: 180rpx;
    }
  }
  
  /* 自定义滚动条 */
  ::-webkit-scrollbar {
    width: 8rpx;
  }
  
  ::-webkit-scrollbar-track {
    background: rgba(0, 0, 0, 0.1);
    border-radius: 4rpx;
  }
  
  ::-webkit-scrollbar-thumb {
    background: linear-gradient(135deg, #4CAF50, #2196F3);
    border-radius: 4rpx;
  }