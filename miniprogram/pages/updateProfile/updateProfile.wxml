<view class="container">
  <!-- 顶部标题栏 -->
  <view class="header">
    <view class="header-back" bindtap="goBack">‹</view>
    <text class="header-title">修改个人信息</text>
    <view class="header-save" bindtap="saveProfile">保存</view>
  </view>

  <!-- 头像修改区域 -->
  <view class="avatar-section">
    <view class="section-title">头像</view>
    <view class="avatar-upload" bindtap="chooseAvatar">
      <image class="avatar-image" src="{{computedAvatarUrl}}"></image>
      <view class="avatar-mask">点击更换</view>
    </view>
  </view>

  <!-- 基本信息表单 -->
  <view class="form-section">
    <view class="section-title">基本信息</view>
    
    <!-- 昵称 -->
    <view class="form-item">
      <text class="item-label">昵称</text>
      <input class="item-input" 
             value="{{computedNickName}}" 
             placeholder="请输入昵称"
             maxlength="20"
             bindinput="onNickNameInput" />
    </view>

    <!-- 性别 -->
    <view class="form-item">
      <text class="item-label">性别</text>
      <picker class="item-picker" 
              range="{{genderOptions}}" 
              value="{{genderIndex}}" 
              bindchange="onGenderChange">
        <view class="picker-value">{{computedGenderText}}</view>
      </picker>
    </view>

    <!-- 地区 -->
    <view class="form-item">
      <text class="item-label">地区</text>
      <picker class="item-picker" 
              mode="region" 
              value="{{region}}" 
              bindchange="onRegionChange">
        <view class="picker-value">{{computedRegionText}}</view>
      </picker>
    </view>

    <!-- 个人简介 -->
    <view class="form-item textarea-item">
      <text class="item-label">个人简介</text>
      <textarea class="item-textarea" 
                value="{{computedBio}}" 
                placeholder="介绍一下自己吧..."
                maxlength="100"
                bindinput="onBioInput" />
      <text class="textarea-count">{{bioLength}}/100</text>
    </view>
  </view>

  <!-- 联系方式 -->
  <view class="form-section">
    <view class="section-title">联系方式</view>
    
    <!-- 邮箱 -->
    <view class="form-item">
      <text class="item-label">邮箱</text>
      <input class="item-input" 
             type="email"
             value="{{computedEmail}}" 
             placeholder="请输入邮箱"
             bindinput="onEmailInput" />
    </view>

    <!-- 手机号 -->
    <view class="form-item">
      <text class="item-label">手机号</text>
      <input class="item-input" 
             type="number"
             value="{{computedPhone}}" 
             placeholder="请输入手机号"
             maxlength="11"
             bindinput="onPhoneInput" />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-section">
    <button class="save-btn" bindtap="saveProfile">保存修改</button>
  </view>
</view>

<!-- 操作提示 -->
<view class="toast" wx:if="{{showToast}}">
  <text class="toast-text">{{toastText}}</text>
</view>

<!-- 加载中提示 -->
<view class="loading" wx:if="{{isLoading}}">
  <view class="loading-spinner"></view>
  <text class="loading-text">保存中...</text>
</view>