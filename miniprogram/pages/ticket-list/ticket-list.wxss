/* pages/ticket-list/ticket-list.wxss */

/* 基础样式 */
.container {
    min-height: 100vh;
    background: linear-gradient(180deg, #f8fafc 0%, #f1f5f9 100%);
    position: relative;
  }
  
  .status-bar-bg {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 200rpx;
    background: linear-gradient(135deg, #007AFF 0%, #00B2FF 100%);
    z-index: 0;
  }
  
  /* 筛选区域 */
  .filter-section {
    position: relative;
    z-index: 1;
    padding: 30rpx;
    margin-top: -40rpx;
  }
  
  .filter-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30rpx;
  }
  
  .section-title {
    font-size: 42rpx;
    font-weight: 700;
    color: white;
    text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  }
  
  .filter-actions {
    display: flex;
    align-items: center;
  }
  
  .refresh-btn {
    width: 70rpx;
    height: 70rpx;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10rpx);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }
  
  .refresh-btn:active {
    background: rgba(255, 255, 255, 0.3);
    transform: rotate(180deg);
  }
  
  .refresh-icon {
    font-size: 32rpx;
    color: white;
  }
  
  .loading-spinner-mini {
    width: 32rpx;
    height: 32rpx;
    border: 4rpx solid rgba(255, 255, 255, 0.3);
    border-top-color: white;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
  
  /* 筛选器 */
  .filters {
    background: white;
    border-radius: 24rpx;
    padding: 32rpx;
    box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.08);
    display: flex;
    gap: 24rpx;
  }
  
  .filter-group {
    flex: 1;
  }
  
  .filter-label {
    display: block;
    font-size: 26rpx;
    color: #6b7280;
    margin-bottom: 16rpx;
    font-weight: 500;
  }
  
  .filter-select {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 28rpx;
    background: #f9fafb;
    border: 2rpx solid #e5e7eb;
    border-radius: 16rpx;
    font-size: 30rpx;
    color: #374151;
    transition: all 0.3s ease;
  }
  
  .filter-select.active {
    background: #f0f9ff;
    border-color: #007AFF;
    color: #007AFF;
  }
  
  .filter-text {
    font-weight: 500;
  }
  
  .filter-arrow {
    font-size: 20rpx;
    opacity: 0.6;
  }
  
  /* 工单列表 */
  .ticket-list {
    height: calc(100vh - 300rpx);
    padding: 0 30rpx 120rpx;
  }
  
  /* 操作卡片 */
  .action-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 24rpx;
    padding: 40rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 10rpx 30rpx rgba(102, 126, 234, 0.3);
    color: white;
  }
  
  .action-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .action-title {
    font-size: 36rpx;
    font-weight: 700;
    margin-bottom: 12rpx;
  }
  
  .action-desc {
    font-size: 28rpx;
    opacity: 0.9;
    margin-bottom: 32rpx;
  }
  
  .submit-btn-wrapper {
    width: 100%;
  }
  
  .submit-btn {
    width: 100%;
    height: 96rpx;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10rpx);
    border: 2rpx solid rgba(255, 255, 255, 0.3);
    border-radius: 20rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  
  .submit-btn::after {
    border: none;
  }
  
  .submit-btn:active {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(2rpx);
  }
  
  .btn-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16rpx;
  }
  
  .btn-icon {
    font-size: 40rpx;
    font-weight: 300;
    line-height: 1;
  }
  
  .btn-text {
    font-size: 32rpx;
    font-weight: 600;
    color: white;
  }
  
  /* 统计卡片 */
  .stats-card {
    background: white;
    border-radius: 20rpx;
    padding: 24rpx 32rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  }
  
  .stats-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  
  .stats-text {
    font-size: 28rpx;
    color: #6b7280;
    font-weight: 500;
  }
  
  .stats-dot {
    width: 8rpx;
    height: 8rpx;
    background: #9ca3af;
    border-radius: 50%;
  }
  
  /* 工单卡片 */
  .ticket-cards {
    margin-bottom: 40rpx;
  }
  
  .ticket-card {
    background: white;
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
    border-left: 8rpx solid;
    position: relative;
    transition: all 0.3s ease;
    overflow: hidden;
  }
  
  .ticket-card:active {
    transform: translateY(-4rpx);
    box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);
  }
  
  .status-tag {
    position: absolute;
    top: 32rpx;
    right: 32rpx;
    padding: 12rpx 20rpx;
    border-radius: 20rpx;
    font-size: 24rpx;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 8rpx;
    backdrop-filter: blur(10rpx);
  }
  
  .status-icon {
    font-size: 22rpx;
  }
  
  .card-content {
    margin-top: 20rpx;
  }
  
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 24rpx;
  }
  
  .ticket-title {
    flex: 1;
    font-size: 36rpx;
    font-weight: 700;
    color: #1f2937;
    line-height: 1.4;
    margin-right: 20rpx;
  }
  
  .type-badge {
    padding: 8rpx 20rpx;
    background: #f3f4f6;
    border-radius: 16rpx;
    font-size: 24rpx;
    color: #6b7280;
    font-weight: 500;
    white-space: nowrap;
  }
  
  .card-body {
    margin-bottom: 28rpx;
  }
  
  .ticket-description {
    font-size: 28rpx;
    color: #6b7280;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24rpx;
    border-top: 1rpx solid #f3f4f6;
  }
  
  .meta-info {
    display: flex;
    flex-direction: column;
    gap: 12rpx;
  }
  
  .meta-item {
    display: flex;
    align-items: center;
    gap: 12rpx;
  }
  
  .meta-icon {
    font-size: 24rpx;
    opacity: 0.7;
  }
  
  .meta-text {
    font-size: 24rpx;
    color: #9ca3af;
  }
  
  .meta-icons {
    display: flex;
    align-items: center;
    gap: 20rpx;
  }
  
  .meta-icon-item {
    display: flex;
    align-items: center;
    gap: 6rpx;
  }
  
  .meta-icon-img, .meta-icon-location {
    font-size: 26rpx;
    opacity: 0.7;
  }
  
  .meta-icon-count {
    font-size: 22rpx;
    color: #9ca3af;
  }
  
  .time-stamp {
    margin-top: 20rpx;
    text-align: right;
  }
  
  .time-text {
    font-size: 22rpx;
    color: #d1d5db;
  }
  
  /* 空状态 */
  .empty-state {
    padding: 120rpx 0;
    text-align: center;
  }
  
  .empty-content {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .empty-icon {
    font-size: 100rpx;
    margin-bottom: 32rpx;
    opacity: 0.3;
  }
  
  .empty-title {
    font-size: 34rpx;
    font-weight: 600;
    color: #6b7280;
    margin-bottom: 16rpx;
  }
  
  .empty-desc {
    font-size: 28rpx;
    color: #9ca3af;
    margin-bottom: 48rpx;
  }
  
  .empty-btn {
    background: linear-gradient(135deg, #007AFF 0%, #00B2FF 100%);
    color: white;
    border: none;
    padding: 24rpx 48rpx;
    border-radius: 20rpx;
    font-size: 28rpx;
    font-weight: 600;
    box-shadow: 0 6rpx 20rpx rgba(0, 122, 255, 0.3);
  }
  
  .empty-btn::after {
    border: none;
  }
  
  /* 加载更多 */
  .load-more-container {
    padding: 40rpx 0;
    display: flex;
    justify-content: center;
  }
  
  .load-more-btn {
    padding: 24rpx 48rpx;
    background: white;
    border: 2rpx solid #e5e7eb;
    border-radius: 20rpx;
    display: flex;
    align-items: center;
    gap: 12rpx;
    transition: all 0.3s ease;
  }
  
  .load-more-btn:active {
    background: #f9fafb;
    transform: translateY(2rpx);
  }
  
  .load-more-text {
    font-size: 28rpx;
    color: #6b7280;
    font-weight: 500;
  }
  
  .load-more-icon {
    font-size: 20rpx;
    color: #9ca3af;
  }
  
  .loading-more {
    display: flex;
    align-items: center;
    gap: 16rpx;
  }
  
  .loading-spinner-small {
    width: 28rpx;
    height: 28rpx;
    border: 3rpx solid #e5e7eb;
    border-top-color: #007AFF;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  
  .loading-text {
    font-size: 26rpx;
    color: #9ca3af;
  }
  
  /* 没有更多数据 */
  .no-more {
    text-align: center;
    padding: 40rpx 0;
  }
  
  .no-more-text {
    font-size: 26rpx;
    color: #d1d5db;
    font-weight: 500;
  }
  
  /* 浮动按钮 */
  .floating-btn {
    position: fixed;
    bottom: 60rpx;
    right: 40rpx;
    width: 100rpx;
    height: 100rpx;
    z-index: 100;
  }
  
  .floating-btn-inner {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #007AFF 0%, #00B2FF 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10rpx 30rpx rgba(0, 122, 255, 0.4);
    transition: all 0.3s ease;
  }
  
  .floating-btn:active .floating-btn-inner {
    transform: scale(0.95);
    box-shadow: 0 5rpx 20rpx rgba(0, 122, 255, 0.3);
  }
  
  .floating-icon {
    font-size: 48rpx;
    color: white;
    font-weight: 300;
    line-height: 1;
  }
  
  /* 加载遮罩 */
  .loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.9);
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(10rpx);
  }
  
  .loading-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32rpx;
  }
  
  .loading-spinner-large {
    width: 80rpx;
    height: 80rpx;
    border: 6rpx solid #e5e7eb;
    border-top-color: #007AFF;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }
  
  .loading-overlay-text {
    font-size: 32rpx;
    color: #6b7280;
    font-weight: 500;
  }
  
  /* 响应式设计 */
  @media (max-width: 750rpx) {
    .filter-section {
      padding: 24rpx;
    }
    
    .filters {
      flex-direction: column;
      gap: 20rpx;
    }
    
    .ticket-list {
      padding: 0 24rpx 120rpx;
    }
    
    .ticket-card {
      padding: 28rpx;
    }
  }