.home-container {
    min-height: 100vh;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 40rpx;
  }
  
  /* 用户信息头部 */
  .user-header {
    padding: 60rpx 0 40rpx 0;
    text-align: center;
  }
  
  .user-info {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .user-avatar {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.3);
    margin-bottom: 20rpx;
  }
  
  .user-nickname {
    font-size: 36rpx;
    color: white;
    font-weight: bold;
  }
  
  /* 功能网格布局 */
  .function-grid {
    margin-top: 40rpx;
  }
  
  .grid-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 40rpx;
  }
  
  .function-card {
    flex: 1;
    background: white;
    border-radius: 20rpx;
    padding: 40rpx 30rpx;
    margin: 0 20rpx;
    text-align: center;
    box-shadow: 0 8rpx 25rpx rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
  }
  
  .function-card:active {
    transform: scale(0.95);
    box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.2);
  }
  
  .card-icon {
    font-size: 60rpx;
    margin-bottom: 20rpx;
    display: block;
  }
  
  .card-title {
    display: block;
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 10rpx;
  }
  
  .card-desc {
    display: block;
    font-size: 24rpx;
    color: #666;
  }
  
  /* 退出按钮 */
  .logout-section {
    margin-top: 80rpx;
    text-align: center;
  }
  
  .logout-btn {
    width: 60%;
    height: 80rpx;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border: 2rpx solid rgba(255, 255, 255, 0.5);
    border-radius: 40rpx;
    font-size: 30rpx;
  }
  
  .logout-btn:active {
    background: rgba(255, 255, 255, 0.3);
  }