/* 页面容器 */
.post-detail-container {
    height: 100vh;
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    display: flex;
    flex-direction: column;
  }
  
  /* 加载状态 */
  .loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 60vh;
  }
  
  .loading-spinner {
    width: 60rpx;
    height: 60rpx;
    border: 6rpx solid #f3f3f3;
    border-top: 6rpx solid #4CAF50;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 20rpx;
  }
  
  .loading-text {
    font-size: 28rpx;
    color: #666;
  }
  
  /* 滚动区域 */
  .content-scroll {
    flex: 1;
    height: 1px; /* 确保scroll-view能正确计算高度 */
  }
  
  /* 帖子头部 */
  .post-header {
    background: white;
    padding: 40rpx 30rpx 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .header-main {
    margin-bottom: 20rpx;
  }
  
  .title-section {
    margin-bottom: 30rpx;
  }
  
  .post-type-badge {
    display: inline-block;
    padding: 8rpx 20rpx;
    border-radius: 20rpx;
    font-size: 22rpx;
    font-weight: 500;
    margin-right: 20rpx;
  }
  
  .post-type-badge.support {
    background: rgba(76, 175, 80, 0.1);
    color: #4CAF50;
  }
  
  .post-type-badge.report {
    background: rgba(255, 107, 107, 0.1);
    color: #FF6B6B;
  }
  
  .post-title {
    font-size: 40rpx;
    font-weight: 600;
    color: #333;
    line-height: 1.4;
    display: block;
  }
  
  .meta-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .author-info {
    display: flex;
    align-items: center;
  }
  
  .author-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    border: 2rpx solid #f0f0f0;
    margin-right: 20rpx;
  }
  
  .author-details {
    display: flex;
    flex-direction: column;
  }
  
  .author-name {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 8rpx;
  }
  
  .post-time {
    font-size: 22rpx;
    color: #999;
  }
  
  .status-section {
    display: flex;
    align-items: center;
    gap: 20rpx;
  }
  
  .current-status {
    padding: 8rpx 16rpx;
    border-radius: 12rpx;
    font-size: 22rpx;
  }
  
  .current-status.pending {
    background: #fff3cd;
    color: #856404;
  }
  
  .current-status.completed {
    background: #d4edda;
    color: #155724;
  }
  
  .status-edit-btn {
    background: #4CAF50;
    color: white;
    border: none;
    border-radius: 8rpx;
    padding: 12rpx 24rpx;
    font-size: 22rpx;
  }
  
  /* 帖子内容区域 */
  .post-content-section {
    background: white;
    margin: 20rpx;
    border-radius: 16rpx;
    padding: 40rpx 30rpx;
    box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
  }
  
  .content-text {
    margin-bottom: 40rpx;
  }
  
  .content-body {
    font-size: 30rpx;
    line-height: 1.6;
    color: #333;
    display: block;
  }
  
  /* 图片网格布局 */
  .images-grid {
    display: grid;
    gap: 20rpx;
    margin-bottom: 40rpx;
  }
  
  .content-image {
    width: 100%;
    border-radius: 12rpx;
    background: #f5f5f5;
  }
  
  .content-image.single-image {
    height: 400rpx;
  }
  
  .content-image.multi-image {
    height: 200rpx;
  }
  
  .images-grid:has(.multi-image) {
    grid-template-columns: repeat(2, 1fr);
  }
  
  .images-grid:has(.multi-image):only-child {
    grid-template-columns: 1fr;
  }
  
  /* 位置信息 */
  .location-info {
    background: #f8f9fa;
    padding: 30rpx;
    border-radius: 12rpx;
    margin-top: 30rpx;
  }
  
  .location-header {
    display: flex;
    align-items: center;
    margin-bottom: 20rpx;
  }
  
  .location-icon {
    margin-right: 15rpx;
    font-size: 24rpx;
  }
  
  .location-title {
    font-size: 26rpx;
    font-weight: 500;
    color: #333;
  }
  
  .location-name {
    display: block;
    font-size: 24rpx;
    color: #666;
    margin-bottom: 8rpx;
  }
  
  .location-address {
    display: block;
    font-size: 22rpx;
    color: #999;
    margin-bottom: 20rpx;
  }
  
  .view-location-btn {
    background: transparent;
    border: 1rpx solid #4CAF50;
    color: #4CAF50;
    border-radius: 20rpx;
    padding: 12rpx 24rpx;
    font-size: 22rpx;
  }
  
  /* 数据统计栏 */
  .stats-bar {
    display: flex;
    background: white;
    margin: 0 20rpx 20rpx;
    border-radius: 16rpx;
    padding: 30rpx;
    justify-content: space-around;
  }
  
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  
  .stat-icon {
    font-size: 32rpx;
    margin-bottom: 10rpx;
  }
  
  .stat-count {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 5rpx;
  }
  
  .stat-label {
    font-size: 22rpx;
    color: #999;
  }
  
  /* 评论区域 */
  .comments-section {
    background: white;
    margin: 0 20rpx 120rpx;
    border-radius: 16rpx;
    padding: 40rpx 30rpx;
  }
  
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30rpx;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .section-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
  }
  
  .sort-options {
    display: flex;
    gap: 30rpx;
  }
  
  .sort-option {
    font-size: 24rpx;
    color: #999;
    padding: 8rpx 16rpx;
    border-radius: 12rpx;
  }
  
  .sort-option.active {
    background: #4CAF50;
    color: white;
  }
  
  /* 评论列表 */
  .comment-item {
    display: flex;
    padding: 30rpx 0;
    border-bottom: 1rpx solid #f8f9fa;
  }
  
  .comment-item:last-child {
    border-bottom: none;
  }
  
  .comment-avatar {
    width: 60rpx;
    height: 60rpx;
    border-radius: 50%;
    margin-right: 20rpx;
  }
  
  .comment-content {
    flex: 1;
  }
  
  .comment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 15rpx;
  }
  
  .comment-author {
    font-size: 26rpx;
    font-weight: 500;
    color: #333;
  }
  
  .comment-time {
    font-size: 22rpx;
    color: #999;
  }
  
  .comment-text {
    font-size: 28rpx;
    line-height: 1.5;
    color: #333;
    margin-bottom: 15rpx;
    display: block;
  }
  
  .comment-actions {
    display: flex;
    align-items: center;
    gap: 30rpx;
  }
  
  .comment-like {
    display: flex;
    align-items: center;
    gap: 10rpx;
  }
  
  .comment-like.liked {
    color: #FF6B6B;
  }
  
  .like-icon {
    font-size: 24rpx;
  }
  
  .like-count {
    font-size: 22rpx;
    color: #999;
  }
  
  .comment-like.liked .like-count {
    color: #FF6B6B;
  }
  
  .reply-btn {
    font-size: 22rpx;
    color: #4CAF50;
  }
  
  .empty-comments {
    text-align: center;
    padding: 60rpx 0;
  }
  
  .empty-icon {
    font-size: 80rpx;
    display: block;
    margin-bottom: 20rpx;
    opacity: 0.5;
  }
  
  .empty-text {
    font-size: 26rpx;
    color: #999;
  }
  
  /* 底部操作栏 */
  .action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: white;
    border-top: 1rpx solid #f0f0f0;
    padding: 20rpx 30rpx;
    display: flex;
    align-items: center;
    gap: 20rpx;
  }
  
  .action-left {
    display: flex;
    gap: 20rpx;
  }
  
  .action-btn {
    display: flex;
    align-items: center;
    gap: 10rpx;
    padding: 15rpx 25rpx;
    border-radius: 25rpx;
    transition: all 0.3s ease;
  }
  
  .action-btn:active {
    background: #f5f5f5;
  }
  
  .action-btn.liked {
    color: #FF6B6B;
  }
  
  .btn-icon {
    font-size: 32rpx;
  }
  
  .btn-text {
    font-size: 26rpx;
    color: #666;
  }
  
  .comment-input-wrapper {
    flex: 1;
    display: flex;
    align-items: center;
    background: #f8f9fa;
    border-radius: 25rpx;
    padding: 0 20rpx;
  }
  
  .comment-input {
    flex: 1;
    font-size: 26rpx;
    padding: 20rpx 0;
    height: 60rpx;
  }
  
  .send-btn {
    background: #4CAF50;
    color: white;
    border: none;
    border-radius: 20rpx;
    padding: 12rpx 24rpx;
    font-size: 24rpx;
    margin-left: 15rpx;
  }
  
  .send-btn:disabled {
    background: #ccc;
    opacity: 0.6;
  }
  
  /* 模态框样式 */
  .modal-mask {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1000;
  }
  
  .modal-content {
    background: white;
    border-radius: 20rpx;
    width: 600rpx;
    max-width: 80%;
    overflow: hidden;
  }
  
  .modal-header {
    padding: 40rpx;
    text-align: center;
    border-bottom: 1rpx solid #f0f0f0;
  }
  
  .modal-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
  }
  
  .modal-body {
    padding: 40rpx;
  }
  
  .status-option {
    display: flex;
    align-items: center;
    padding: 30rpx 0;
    border-bottom: 1rpx solid #f8f9fa;
  }
  
  .status-option:last-child {
    border-bottom: none;
  }
  
  .status-radio {
    font-size: 24rpx;
    margin-right: 20rpx;
    color: #4CAF50;
  }
  
  .status-label {
    font-size: 28rpx;
    color: #333;
  }
  
  .modal-footer {
    display: flex;
    border-top: 1rpx solid #f0f0f0;
  }
  
  .modal-btn {
    flex: 1;
    height: 80rpx;
    border: none;
    border-radius: 0;
    font-size: 28rpx;
  }
  
  .modal-btn.cancel {
    background: white;
    color: #666;
    border-right: 1rpx solid #f0f0f0;
  }
  
  .modal-btn.confirm {
    background: #4CAF50;
    color: white;
  }
  
  /* 动画 */
  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }