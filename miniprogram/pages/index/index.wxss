/**index.wxss**/
.container {
    min-height: 100vh;
    background: linear-gradient(180deg, #f5f5f5 0%, #e8f5e8 100%);
    padding: 0 30rpx;
  }
  
  /* 用户信息头部 */
  .user-header {
    padding: 60rpx 0 40rpx 0;
    display: flex;
    justify-content: flex-end;
  }
  
  .user-info {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.9);
    padding: 20rpx 30rpx;
    border-radius: 50rpx;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  }
  
  .user-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 20rpx;
    border: 2rpx solid #4CAF50;
  }
  
  .user-nickname {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
  }
  
  /* 主功能按钮区域 */
  .main-buttons {
    margin-top: 60rpx;
  }
  
  .button-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 40rpx;
  }
  
  .function-btn {
    width: 330rpx;
    height: 200rpx;
    background: white;
    border-radius: 20rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: none;
    box-shadow: 0 8rpx 30rpx rgba(76, 175, 80, 0.2);
    transition: all 0.3s ease;
  }
  
  .function-btn:active {
    transform: translateY(4rpx);
    box-shadow: 0 4rpx 15rpx rgba(76, 175, 80, 0.3);
  }
  
  .btn-icon {
    font-size: 60rpx;
    margin-bottom: 20rpx;
  }
  
  .btn-text {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
    text-align: center;
  }
  
  /* 退出登录按钮 */
  .logout-section {
    position: fixed;
    bottom: 60rpx;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
  }
  
  .logout-btn {
    width: 300rpx;
    height: 80rpx;
    background: #ff6b6b;
    color: white;
    border-radius: 40rpx;
    font-size: 28rpx;
    border: none;
  }