.container {
    min-height: 100vh;
    /* 推荐：专业法律主题深蓝渐变 */
    background: linear-gradient(135deg, #1a3c6e 0%, #2a5298 100%);
    padding: 0;
}

/* 页面标题 - 适配新背景色 */
.page-header {
    padding: 60rpx 30rpx 40rpx;
    text-align: center;
    color: white;
}

.page-title {
    display: block;
    font-size: 48rpx;
    font-weight: bold;
    margin-bottom: 10rpx;
    text-shadow: 0 2rpx 10rpx rgba(0,0,0,0.3);
}

.page-subtitle {
    display: block;
    font-size: 24rpx;
    opacity: 0.9;
    font-weight: 300;
}

/* 搜索区域 - 微调透明度适配新背景 */
.search-section {
    background: rgba(255,255,255,0.95);
    margin: 0 30rpx;
    border-radius: 20rpx;
    padding: 40rpx 30rpx 30rpx;
    box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.2);
    backdrop-filter: blur(10px);
}

.search-box {
    display: flex;
    align-items: center;
    background: white;
    border-radius: 15rpx;
    border: 2rpx solid #e0e0e0;
    padding: 0 25rpx;
    margin-bottom: 30rpx;
    transition: all 0.3s;
}

.search-box:focus-within {
    border-color: #667eea;
    box-shadow: 0 0 0 3rpx rgba(102, 126, 234, 0.1);
}

.search-icon {
    font-size: 32rpx;
    margin-right: 20rpx;
    color: #999;
}

.search-input {
    flex: 1;
    padding: 25rpx 0;
    font-size: 28rpx;
    color: #333;
    border: none;
    outline: none;
}

.search-input::placeholder {
    color: #bbb;
}

.search-btn {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    border: none;
    border-radius: 10rpx;
    padding: 20rpx 40rpx;
    font-size: 28rpx;
    font-weight: 500;
    margin-left: 20rpx;
    transition: all 0.3s;
}

.btn-hover {
    transform: scale(0.95);
    opacity: 0.9;
}

/* 快捷搜索 */
.quick-search {
    border-top: 1rpx solid #f0f0f0;
    padding-top: 30rpx;
}

.quick-title {
    display: block;
    font-size: 24rpx;
    color: #666;
    margin-bottom: 20rpx;
    font-weight: 500;
}

.tag-container {
    display: flex;
    flex-wrap: wrap;
    gap: 15rpx;
}

.tag {
    background: #f8f9fa;
    color: #667eea;
    padding: 12rpx 25rpx;
    border-radius: 20rpx;
    font-size: 24rpx;
    border: 1rpx solid #e0e0e0;
    transition: all 0.3s;
}

.tag:active {
    background: #667eea;
    color: white;
    transform: scale(0.95);
}

/* 加载状态 */
.loading-state {
    padding: 100rpx 30rpx;
    background: white;
    margin: 30rpx;
    border-radius: 20rpx;
    text-align: center;
}

.loading-content {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.loading-spinner {
    width: 80rpx;
    height: 80rpx;
    border: 4rpx solid #f3f3f3;
    border-top: 4rpx solid #667eea;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 30rpx;
}

.loading-text {
    font-size: 32rpx;
    color: #333;
    font-weight: 500;
    margin-bottom: 10rpx;
}

.loading-tip {
    font-size: 24rpx;
    color: #999;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* 结果区域 */
.results-section {
    padding: 40rpx 30rpx;
    background: transparent;
}

/* 结果区域文字颜色保持白色 */
.results-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30rpx;
    padding: 0 10rpx;
}

.results-count {
    font-size: 28rpx;
    color: white; /* 保持白色，在新背景上更清晰 */
    font-weight: 500;
}

.results-sort {
    font-size: 24rpx;
    color: rgba(255,255,255,0.8); /* 保持半透明白色 */
}

/* 结果卡片 */
.results-list {
    display: flex;
    flex-direction: column;
    gap: 30rpx;
}

.result-card {
    background: white;
    border-radius: 20rpx;
    padding: 40rpx 35rpx 35rpx;
    box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.1);
    position: relative;
    transition: all 0.3s;
    border: 1rpx solid rgba(255,255,255,0.2);
}

.result-card:active {
    transform: translateY(-2rpx);
    box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.15);
}

.card-header {
    margin-bottom: 25rpx;
    position: relative;
    padding-right: 120rpx;
}

.law-title-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 15rpx;
}

.law-title {
    flex: 1;
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
    line-height: 1.4;
    margin-right: 20rpx;
}

.relevance-badge {
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    padding: 8rpx 16rpx;
    border-radius: 20rpx;
    font-size: 20rpx;
    font-weight: bold;
    min-width: 80rpx;
    text-align: center;
    flex-shrink: 0;
}

.law-meta {
    display: flex;
    align-items: center;
    gap: 15rpx;
}

.meta-item {
    font-size: 24rpx;
    color: #666;
}

.meta-divider {
    color: #ddd;
}

.meta-item.valid {
    color: #4CAF50;
    font-weight: 500;
}

.meta-item.invalid {
    color: #f44336;
    font-weight: 500;
}

.card-content {
    margin-bottom: 25rpx;
}

.content-preview {
    font-size: 28rpx;
    line-height: 1.6;
    color: #666;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 20rpx;
    border-top: 1rpx solid #f0f0f0;
}

.date-info {
    font-size: 22rpx;
    color: #999;
}

.detail-btn {
    background: #667eea;
    color: white;
    border: none;
    border-radius: 8rpx;
    padding: 12rpx 25rpx;
    font-size: 24rpx;
    transition: all 0.3s;
}

.detail-btn:active {
    background: #5a6fd8;
    transform: scale(0.95);
}

.card-index {
    position: absolute;
    top: -15rpx;
    left: -15rpx;
    width: 50rpx;
    height: 50rpx;
    background: linear-gradient(135deg, #667eea, #764ba2);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20rpx;
    font-weight: bold;
    box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.4);
}

/* 空状态 */
.empty-state, .welcome-state {
    background: white;
    border-radius: 20rpx;
    padding: 80rpx 40rpx;
    text-align: center;
    margin-top: 50rpx;
    box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.1);
}

.empty-icon, .welcome-icon {
    font-size: 80rpx;
    margin-bottom: 30rpx;
    display: block;
}

.empty-title, .welcome-title {
    display: block;
    font-size: 36rpx;
    color: #333;
    font-weight: bold;
    margin-bottom: 15rpx;
}

.empty-tip, .welcome-tip {
    display: block;
    font-size: 28rpx;
    color: #666;
    line-height: 1.5;
    margin-bottom: 40rpx;
}

.empty-btn {
    background: #667eea;
    color: white;
    border: none;
    border-radius: 10rpx;
    padding: 20rpx 40rpx;
    font-size: 28rpx;
}

/* 特性列表 */
.feature-list {
    display: flex;
    justify-content: space-around;
    margin-top: 40rpx;
}

.feature-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10rpx;
}

.feature-icon {
    font-size: 40rpx;
    margin-bottom: 5rpx;
}

.feature-text {
    font-size: 22rpx;
    color: #666;
    text-align: center;
}

/* 响应式适配 */
@media (max-width: 375px) {
    .search-section {
        margin: 0 20rpx;
        padding: 30rpx 20rpx;
    }
    
    .results-section {
        padding: 30rpx 20rpx;
    }
    
    .feature-list {
        flex-direction: column;
        gap: 20rpx;
    }
}