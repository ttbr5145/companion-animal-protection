.login-container {
    padding: 100rpx 60rpx;
    min-height: 100vh;
    /* background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); */
    background: gray;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  
  .logo {
    margin-bottom: 80rpx;
    text-align: center;
  }
  
  .logo-text {
    font-size: 48rpx;
    font-weight: bold;
    color: black;
  }
  
  .welcome {
    margin-bottom: 120rpx;
    text-align: center;
  }
  
  .welcome text {
    font-size: 36rpx;
    color: rgba(0, 0, 0, 0.9);
  }
  
  .login-btn-container {
    width: 100%;
    margin-bottom: 60rpx;
  }
  
  .wechat-login-btn {
    width: 100%;
    height: 90rpx;
    background: #07C160;
    color: white;
    border-radius: 45rpx;
    font-size: 34rpx;
    border: none;
  }
  
  .wechat-login-btn::after {
    border: none;
  }
  
  .wechat-login-btn:active {
    background: #06AD56;
  }
  
  .tip {
    text-align: center;
  }
  
  .tip text {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.7);
  }